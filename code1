        labels_array = labels.numpy()

        for image, label in zip(
            images_array,
            labels_array
        ):

            images_list.append(
                image
            )

            labels_list.append(
                int(label)
            )

            if len(images_list) >= BLOCK10_MAX_TEST_SAMPLES:

                break

        if len(images_list) >= BLOCK10_MAX_TEST_SAMPLES:

            break

    if not images_list:

        raise ValueError(
            "No test images were collected for Block 10."
        )

    return (

        np.asarray(
            images_list,
            dtype=np.float32
        ),

        np.asarray(
            labels_list,
            dtype=np.int64
        )

    )

