def build_efficientnet_b5(num_classes, input_shape=IMAGE_SHAPE):
    inputs = tf.keras.Input(shape=input_shape, name="image")
    x = make_augmentation()(inputs)
    # EfficientNet Keras implementation includes its own input rescaling.
    backbone = tf.keras.applications.EfficientNetB5(
        include_top=False, weights="imagenet",
        input_shape=input_shape, pooling=None
    )
    backbone.trainable = False
    x = backbone(x, training=False)
    x = tf.keras.layers.GlobalAveragePooling2D()(x)
    x = tf.keras.layers.Dropout(0.35)(x)
    outputs = tf.keras.layers.Dense(num_classes, activation="softmax")(x)
    model = tf.keras.Model(inputs, outputs, name="EfficientNetB5")
    model.backbone = backbone
    return compile_classifier(model)


def build_application_classifier(app_name, num_classes, input_shape=IMAGE_SHAPE):
    inputs = tf.keras.Input(shape=input_shape, name="image")
    x = make_augmentation()(inputs)

    if app_name == "VGG16":
        x = tf.keras.applications.vgg16.preprocess_input(x)
        backbone = tf.keras.applications.VGG16(
            include_top=False, weights="imagenet",
            input_shape=input_shape, pooling=None
        )
    elif app_name == "VGG19":
        x = tf.keras.applications.vgg19.preprocess_input(x)
        backbone = tf.keras.applications.VGG19(
            include_top=False, weights="imagenet",
            input_shape=input_shape, pooling=None
        )
    elif app_name == "ResNet101V2":
        x = tf.keras.applications.resnet_v2.preprocess_input(x)
        backbone = tf.keras.applications.ResNet101V2(
            include_top=False, weights="imagenet",
            input_shape=input_shape, pooling=None
        )
    elif app_name == "InceptionV3":
        x = tf.keras.applications.inception_v3.preprocess_input(x)
        backbone = tf.keras.applications.InceptionV3(
            include_top=False, weights="imagenet",
            input_shape=input_shape, pooling=None
        )
    else:
        raise ValueError(f"Unsupported application: {app_name}")

    backbone.trainable = False
    x = backbone(x, training=False)
    x = tf.keras.layers.GlobalAveragePooling2D()(x)
    x = tf.keras.layers.Dropout(0.35)(x)
    outputs = tf.keras.layers.Dense(num_classes, activation="softmax")(x)
    model = tf.keras.Model(inputs, outputs, name=app_name)
    model.backbone = backbone
    return compile_classifier(model)


def residual_unit(x, filters, stride=1):
    shortcut = x
    y = tf.keras.layers.Conv2D(
        filters, 3, strides=stride, padding="same", use_bias=False
    )(x)
    y = tf.keras.layers.BatchNormalization()(y)
    y = tf.keras.layers.ReLU()(y)
    y = tf.keras.layers.Conv2D(
        filters, 3, padding="same", use_bias=False
    )(y)
    y = tf.keras.layers.BatchNormalization()(y)

    if stride != 1 or int(shortcut.shape[-1]) != filters:
        shortcut = tf.keras.layers.Conv2D(
            filters, 1, strides=stride, padding="same", use_bias=False
        )(shortcut)
        shortcut = tf.keras.layers.BatchNormalization()(shortcut)

    y = tf.keras.layers.Add()([shortcut, y])
    return tf.keras.layers.ReLU()(y)


def build_resnet9(num_classes, input_shape=IMAGE_SHAPE):
    """Compact ResNet-9-style network trained from scratch."""
    inputs = tf.keras.Input(shape=input_shape, name="image")
    x = make_augmentation()(inputs)
    x = tf.keras.layers.Rescaling(1.0 / 255.0)(x)
    x = tf.keras.layers.Conv2D(64, 3, padding="same", use_bias=False)(x)
    x = tf.keras.layers.BatchNormalization()(x)
    x = tf.keras.layers.ReLU()(x)
    x = residual_unit(x, 128, stride=2)
    x = tf.keras.layers.MaxPooling2D()(x)
    x = residual_unit(x, 256, stride=2)
    x = tf.keras.layers.MaxPooling2D()(x)
    x = tf.keras.layers.Conv2D(512, 3, padding="same", use_bias=False)(x)
    x = tf.keras.layers.BatchNormalization()(x)
    x = tf.keras.layers.ReLU()(x)
    x = tf.keras.layers.GlobalMaxPooling2D()(x)
    x = tf.keras.layers.Dropout(0.40)(x)
    outputs = tf.keras.layers.Dense(num_classes, activation="softmax")(x)
    return compile_classifier(
        tf.keras.Model(inputs, outputs, name="ResNet9_SHAP")
    )


