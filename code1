def build_cnn_mha(num_classes, input_shape=IMAGE_SHAPE):
    """
    CNN feature extraction followed by spatial-token MHA.
    Input is RGB float pixels in [0,255], as produced by Block 2.
    """
    inputs = tf.keras.Input(shape=input_shape, name="image")
    x = make_augmentation()(inputs)

    for filters in [32, 64, 128, 256]:
        x = tf.keras.layers.Conv2D(
            filters, 3, padding="same", use_bias=False
        )(x)
        x = tf.keras.layers.BatchNormalization()(x)
        x = tf.keras.layers.Activation("relu")(x)
        x = tf.keras.layers.Conv2D(
            filters, 3, padding="same", use_bias=False
        )(x)
        x = tf.keras.layers.BatchNormalization()(x)
        x = tf.keras.layers.Activation("relu")(x)
        x = tf.keras.layers.MaxPooling2D(pool_size=2)(x)
        if filters in [128, 256]:
            x = tf.keras.layers.Dropout(0.15)(x)

    # Preserve the spatial feature map for Grad-CAM.
    feature_map = x
    channels = int(feature_map.shape[-1])
    tokens = tf.keras.layers.Reshape(
        (-1, channels), name="spatial_tokens"
    )(feature_map)

    attention = tf.keras.layers.MultiHeadAttention(
        num_heads=4,
        key_dim=max(channels // 4, 32),
        dropout=0.10,
        name="multi_head_attention"
    )(tokens, tokens)

    x = tf.keras.layers.Add(name="attention_residual")([tokens, attention])
    x = tf.keras.layers.LayerNormalization()(x)
    x = tf.keras.layers.GlobalAveragePooling1D()(x)
    x = tf.keras.layers.Dense(256, activation="relu")(x)
    x = tf.keras.layers.Dropout(0.40)(x)
    outputs = tf.keras.layers.Dense(
        num_classes, activation="softmax", name="predictions"
    )(x)

    model = tf.keras.Model(inputs, outputs, name="CNN_MHA_GradCAM")
    return compile_classifier(model)


