def discover_images_from_directory(
    dataset_root
):

    dataset_root = Path(dataset_root)

    discovered = []

    if not dataset_root.exists():

        LOGGER.warning(
            "Dataset directory does not exist: %s",
            dataset_root
        )

        return discovered

    for file_path in dataset_root.rglob("*"):

        if not file_path.is_file():

            continue

        if file_path.suffix.lower() not in VALID_IMAGE_EXTENSIONS:

            continue

        # Exclude files inside common non-image output folders
        excluded_parts = {

            "models",
            "results",
            "checkpoints",
            "cache",
            "__pycache__"

        }

        if any(
            part.lower() in excluded_parts
            for part in file_path.parts
        ):

            continue

        discovered.append(
            file_path.resolve()
        )

    return sorted(
        set(discovered)
    )


# ============================================================
# 6. EXTRACT RECORDS FROM COMMON MANIFEST STRUCTURES
# ============================================================

# This function supports common JSON record layouts.
# It does not silently guess arbitrary field names.

IMAGE_FIELD_CANDIDATES = [

    "image_path",
    "image",
    "filepath",
    "file_path",
    "path",
    "filename",
    "file"

]

LABEL_FIELD_CANDIDATES = [

    "label",
    "class",
    "class_name",
    "disease",
    "category",
    "disease_name"

]


def find_candidate_field(
    record,
    candidates
):

    if not isinstance(record, dict):

        return None

    normalized = {

        str(key).strip().lower(): key

        for key in record.keys()

    }

    for candidate in candidates:

        if candidate in normalized:

            return normalized[candidate]

    return None


def extract_records_from_manifest(
    manifest
):

    records = []

    if isinstance(manifest, list):

        records = [

            item

            for item in manifest

            if isinstance(item, dict)

        ]

    elif isinstance(manifest, dict):

        # Look for common record collections
        collection_candidates = [

            "images",
            "samples",
            "records",
            "data",
            "files",
            "annotations",
            "items"

        ]

        normalized_keys = {

            str(key).strip().lower(): key

            for key in manifest.keys()

        }

        for candidate in collection_candidates:

            if candidate in normalized_keys:

                collection = manifest[
                    normalized_keys[candidate]
                ]

                if isinstance(collection, list):

                    records = [

                        item

                        for item in collection

                        if isinstance(item, dict)

                    ]

                    break

        # If no known collection is found,
        # check whether the root itself is a single image record.
        if not records:

            image_field = find_candidate_field(
                manifest,
                IMAGE_FIELD_CANDIDATES
            )

            label_field = find_candidate_field(
                manifest,
                LABEL_FIELD_CANDIDATES
            )

            if image_field and label_field:

                records = [manifest]

    return records


# ============================================================
# 7. RESOLVE IMAGE PATHS
# ============================================================

def resolve_image_path(
    image_value,
    dataset_root
):

    if image_value is None:

        return None

    image_path = Path(
        str(image_value).strip()
    )

    if image_path.is_absolute():

        candidates = [image_path]

    else:

        candidates = [

            dataset_root / image_path,

            dataset_root / "images" / image_path,

            PROJECT_DIR / image_path,

            PROJECT_DIR / "data" / image_path

        ]

    for candidate in candidates:

        if candidate.exists() and candidate.is_file():

            if candidate.suffix.lower() in VALID_IMAGE_EXTENSIONS:

                return candidate.resolve()

    return None


# ============================================================
# 8. CONVERT MANIFEST RECORDS INTO DATAFRAME
# ============================================================

def manifest_to_dataframe(
    dataset_name,
    manifest,
    dataset_root
):

    records = extract_records_from_manifest(
        manifest
    )

    if not records:

        return pd.DataFrame(
            columns=[
                "dataset",
                "image_path",
                "label"
            ]
        )

    extracted = []

    for record in records:

        image_field = find_candidate_field(
            record,
            IMAGE_FIELD_CANDIDATES
        )

        label_field = find_candidate_field(
            record,
            LABEL_FIELD_CANDIDATES
        )

        if image_field is None or label_field is None:

            continue

        image_path = resolve_image_path(
            record[image_field],
            dataset_root
        )

        label = record[label_field]

        if image_path is None or label is None:

            continue

        extracted.append({

            "dataset": dataset_name,

            "image_path": str(image_path),

            "label": str(label).strip()

        })

    return pd.DataFrame(
        extracted,
        columns=[
            "dataset",
            "image_path",
            "label"
        ]
    )


# ============================================================
# 9. VALIDATE IMAGE FILES
# ============================================================

def validate_image_file(
    image_path
):

    try:

        with Image.open(image_path) as image:

            image.verify()

        return True

    except (
        UnidentifiedImageError,
        OSError,
        ValueError
    ):

        return False


def validate_dataframe_images(
    dataframe,
    dataset_name
):

    if dataframe.empty:

        return dataframe

    if not VERIFY_IMAGE_FILES:

        return dataframe

    print(
        f"\nValidating images for {dataset_name}..."
    )

    valid_mask = dataframe["image_path"].apply(
        validate_image_file
    )

    valid_count = int(
        valid_mask.sum()
    )

    invalid_count = int(
        (~valid_mask).sum()
    )

    print(
        f"Valid images: {valid_count}"
    )

    print(
        f"Invalid images: {invalid_count}"
    )

    if invalid_count > 0:

        LOGGER.warning(
            "%s contains %d invalid image files.",
            dataset_name,
            invalid_count
        )

        if SKIP_CORRUPTED_IMAGES:

            dataframe = dataframe.loc[
                valid_mask
            ].copy()

    return dataframe.reset_index(
        drop=True
    )


# ============================================================
# 10. FALLBACK DIRECTORY-BASED DATASET DISCOVERY
# ============================================================

# This fallback is used only if the manifest cannot be
# converted into image records.
#
# Expected conventional structure:
#
# rice/
#     Disease_A/
#         image1.jpg
#         image2.jpg
#     Disease_B/
#         image3.jpg
#
# The class name is taken from the immediate parent folder.
# No class names are hardcoded.


def dataframe_from_directory(
    dataset_name,
    dataset_root
):

    discovered_images = discover_images_from_directory(
        dataset_root
    )

    records = []

    for image_path in discovered_images:

        relative_path = image_path.relative_to(
            dataset_root.resolve()
        )

        if len(relative_path.parts) < 2:

            continue

        class_name = relative_path.parts[0]

        records.append({

            "dataset": dataset_name,

            "image_path": str(image_path),

            "label": str(class_name)

        })

    return pd.DataFrame(
        records,
        columns=[
            "dataset",
            "image_path",
            "label"
        ]
    )


