def prepare_dataset_splits(
    dataset_dataframes
):

    prepared_datasets = {}

    for dataset_name, dataframe in dataset_dataframes.items():

        if dataframe.empty:

            continue

        print("\n" + "=" * 75)

        print(
            "ENCODING AND SPLITTING:",
            dataset_name.upper()
        )

        print("=" * 75)

        classes = sorted(
            dataframe["label"].unique().tolist()
        )

        label_to_index = {

            label: index

            for index, label in enumerate(classes)

        }

        dataframe = dataframe.copy()

        dataframe["encoded_label"] = (
            dataframe["label"].map(label_to_index)
        )

        splits = split_dataset_dataframe(

            dataframe=dataframe,

            dataset_name=dataset_name

        )

        # Save label mapping for reproducibility
        label_mapping = {

            str(label): int(index)

            for label, index in label_to_index.items()

        }

        mapping_path = TABLE_DIR / (
            f"{dataset_name}_label_mapping.json"
        )

        with open(
            mapping_path,
            "w",
            encoding="utf-8"
        ) as file:

            json.dump(
                label_mapping,
                file,
                indent=4,
                ensure_ascii=False
            )

        # Construct TensorFlow datasets
        train_tf = create_tf_dataset(

            splits["train"],

            training=True

        )

        validation_tf = create_tf_dataset(

            splits["validation"],

            training=False

        )

        test_tf = create_tf_dataset(

            splits["test"],

            training=False

        )

        prepared_datasets[dataset_name] = {

            "classes": classes,

            "label_to_index": label_to_index,

            "num_classes": len(classes),

            "train_dataframe": splits["train"],

            "validation_dataframe": splits["validation"],

            "test_dataframe": splits["test"],

            "train": train_tf,

            "validation": validation_tf,

            "test": test_tf

        }

        print(
            "Number of classes:",
            len(classes)
        )

        print(
            "Class mapping:",
            label_mapping
        )

        print(
            "TensorFlow datasets created successfully."
        )

    return prepared_datasets


