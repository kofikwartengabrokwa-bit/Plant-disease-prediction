def specificity_macro(y_true, y_pred, num_classes):
    cm = confusion_matrix(y_true, y_pred, labels=np.arange(num_classes))
    values = []
    for i in range(num_classes):
        tp = cm[i, i]
        fn = cm[i, :].sum() - tp
        fp = cm[:, i].sum() - tp
        tn = cm.sum() - (tp + fn + fp)
        values.append(tn / (tn + fp) if (tn + fp) else np.nan)
    return float(np.nanmean(values))


def calculate_metrics(y_true, y_prob, num_classes):
    y_pred = np.argmax(y_prob, axis=1)
    result = {
        "accuracy": accuracy_score(y_true, y_pred),
        "precision_macro": precision_score(
            y_true, y_pred, average="macro", zero_division=0
        ),
        "recall_macro": recall_score(
            y_true, y_pred, average="macro", zero_division=0
        ),
        "f1_macro": f1_score(
            y_true, y_pred, average="macro", zero_division=0
        ),
        "specificity_macro": specificity_macro(
            y_true, y_pred, num_classes
        ),
        "balanced_accuracy": balanced_accuracy_score(y_true, y_pred),
        "mcc": matthews_corrcoef(y_true, y_pred),
        "cohen_kappa": cohen_kappa_score(y_true, y_pred)
    }
    try:
        if num_classes == 2:
            result["auc_macro"] = roc_auc_score(y_true, y_prob[:, 1])
        else:
            result["auc_macro"] = roc_auc_score(
                y_true, y_prob, multi_class="ovr", average="macro"
            )
    except ValueError:
        result["auc_macro"] = np.nan
    return result, y_pred


def evaluate_all_models(dataset_name, data):
    class_names = data["classes"]
    num_classes = data["num_classes"]
    rows = []

    for model_key in [
        "CNN_MHA",
        "EfficientNetB5_GradCAM",
        "EfficientNetB5_LIME",
        "Four_Model_Ensemble_LIME",
        "ResNet9_SHAP"
    ]:
        print(f"\nEvaluating {dataset_name}: {model_key}")
        y_true, y_prob = predict_experiment_model(
            dataset_name, model_key, data["test"]
        )
        metrics, y_pred = calculate_metrics(y_true, y_prob, num_classes)

        model = MODEL_REGISTRY[(dataset_name, model_key)]
        if isinstance(model, dict):
            params = sum(m.count_params() for m in model.values())
            model_size_mb = sum(
                model_file(dataset_name, k).stat().st_size
                for k in model.keys()
                if model_file(dataset_name, k).exists()
            ) / (1024 ** 2)
        else:
            params = model.count_params()
            saved_path = model_file(
                dataset_name,
                "EfficientNetB5" if model_key.startswith("EfficientNetB5")
                else ("CNN_MHA" if model_key == "CNN_MHA" else "ResNet9")
            )
            model_size_mb = (
                saved_path.stat().st_size / (1024 ** 2)
                if saved_path.exists() else np.nan
            )

        training_key = (
            "CNN_MHA" if model_key == "CNN_MHA"
            else "EfficientNetB5" if model_key.startswith("EfficientNetB5")
            else "ResNet9" if model_key == "ResNet9_SHAP"
            else None
        )
        training_time = np.nan
        if training_key:
            found = [r for r in TRAINING_RECORDS
                     if r["dataset"] == dataset_name
                     and r["model"] == training_key]
            if found:
                training_time = found[-1]["training_time_seconds"]

        rows.append({
            "dataset": dataset_name,
            "model": model_key,
            **{k: float(v) if np.isfinite(v) else np.nan
               for k, v in metrics.items()},
            "training_time_seconds": training_time,
            "total_parameters": int(params),
            "model_size_mb": float(model_size_mb)
        })

        PREDICTION_RECORDS[(dataset_name, model_key)] = {
            "y_true": y_true,
            "y_pred": y_pred,
            "y_prob": y_prob
        }

        cm = confusion_matrix(y_true, y_pred, labels=np.arange(num_classes))
        CONFUSION_MATRICES[(dataset_name, model_key)] = cm

        report = classification_report(
            y_true, y_pred, labels=np.arange(num_classes),
            target_names=class_names, output_dict=True, zero_division=0
        )
        pd.DataFrame(report).transpose().to_csv(
            Path(TABLE_DIR) / f"{dataset_name}_{model_key}_classification_report.csv"
        )

        if SAVE_PREDICTIONS:
            pred_df = pd.DataFrame({
                "true_label_index": y_true,
                "predicted_label_index": y_pred,
                "true_label": [class_names[i] for i in y_true],
                "predicted_label": [class_names[i] for i in y_pred],
                "confidence": np.max(y_prob, axis=1)
            })
            pred_df.to_csv(
                Path(RESULTS_DIR) / "predictions" /
                f"{dataset_name}_{model_key}_predictions.csv",
                index=False
            )

    result_df = pd.DataFrame(rows)
    result_df.to_csv(
        Path(TABLE_DIR) / f"{dataset_name}_model_comparison.csv",
        index=False
    )
    return result_df


