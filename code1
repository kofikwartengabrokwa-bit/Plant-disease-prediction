def explain_with_shap(dataset_name, data, max_examples=SHAP_EXPLANATION_COUNT):
    try:
        import shap
    except ImportError as exc:
        raise ImportError("SHAP is optional. Install with: pip install shap") from exc

    model = MODEL_REGISTRY[(dataset_name, "ResNet9_SHAP")]
    out_dir = Path(SHAP_DIR) / dataset_name / "ResNet9_SHAP"
    out_dir.mkdir(parents=True, exist_ok=True)

    # Collect small, deterministic batches from training and test data.
    background_images = []
    for images, _ in data["train"]:
        background_images.append(images.numpy())
        if sum(len(x) for x in background_images) >= SHAP_BACKGROUND_COUNT:
            break
    background = np.concatenate(background_images, axis=0)[:SHAP_BACKGROUND_COUNT]

    test_images, test_labels = [], []
    for images, labels in data["test"]:
        test_images.append(images.numpy())
        test_labels.append(labels.numpy())
        if sum(len(x) for x in test_images) >= max_examples:
            break
    explain_x = np.concatenate(test_images, axis=0)[:max_examples]
    explain_y = np.concatenate(test_labels, axis=0)[:max_examples]

    # GradientExplainer is generally more practical than KernelExplainer
    # for a differentiable CNN. Output shape depends on SHAP version.
    explainer = shap.GradientExplainer(model, background)
    shap_values = explainer.shap_values(explain_x)

    # Save per-image mean absolute attribution heatmaps.
    if isinstance(shap_values, list):
        # Older SHAP versions: list indexed by output class.
        for i in range(len(explain_x)):
            class_idx = int(np.argmax(model.predict(explain_x[i:i+1], verbose=0)[0]))
            values = np.asarray(shap_values[class_idx])[i]
            heatmap = np.mean(np.abs(values), axis=-1)
            heatmap = heatmap / (heatmap.max() + 1e-8)
            fig, axes = plt.subplots(1, 2, figsize=(8, 4))
            axes[0].imshow(explain_x[i].astype(np.uint8))
            axes[0].set_title("Original")
            axes[1].imshow(heatmap, cmap="inferno")
            axes[1].set_title(f"SHAP attribution: {data['classes'][class_idx]}")
            for ax in axes:
                ax.axis("off")
            plt.tight_layout()
            plt.savefig(out_dir / f"shap_{i:03d}.png", dpi=250)
            plt.close()
    else:
        values = np.asarray(shap_values)
        # Newer versions often return [samples, H, W, channels, classes].
        for i in range(len(explain_x)):
            class_idx = int(np.argmax(model.predict(explain_x[i:i+1], verbose=0)[0]))
            sample_values = values[i]
            if sample_values.ndim == 4:
                sample_values = sample_values[..., class_idx]
            heatmap = np.mean(np.abs(sample_values), axis=-1)
            heatmap = heatmap / (heatmap.max() + 1e-8)
            fig, axes = plt.subplots(1, 2, figsize=(8, 4))
            axes[0].imshow(explain_x[i].astype(np.uint8))
            axes[0].set_title("Original")
            axes[1].imshow(heatmap, cmap="inferno")
            axes[1].set_title(f"SHAP attribution: {data['classes'][class_idx]}")
            for ax in axes:
                ax.axis("off")
            plt.tight_layout()
            plt.savefig(out_dir / f"shap_{i:03d}.png", dpi=250)
            plt.close()


