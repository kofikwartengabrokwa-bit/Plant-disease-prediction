def find_last_conv_layer(model):
    candidates = [
        layer.name for layer in model.layers
        if isinstance(layer, tf.keras.layers.Conv2D)
    ]
    if candidates:
        return candidates[-1]

    # Search nested backbone when the outer model has no Conv2D layer.
    for layer in reversed(model.layers):
        if isinstance(layer, tf.keras.Model):
            nested = [
                sublayer.name for sublayer in layer.layers
                if isinstance(sublayer, tf.keras.layers.Conv2D)
            ]
            if nested:
                return layer.name, nested[-1]
    raise ValueError("No convolutional layer found for Grad-CAM.")


def gradcam_heatmap(model, image_batch, class_index=None):
    """
    Grad-CAM for a model with a directly addressable final Conv2D layer.
    For nested application backbones, a nested feature extractor is built.
    """
    target = find_last_conv_layer(model)
    if isinstance(target, tuple):
        outer_name, inner_name = target
        backbone = model.get_layer(outer_name)
        conv_layer = backbone.get_layer(inner_name)
        feature_model = tf.keras.Model(
            backbone.input, [conv_layer.output, backbone.output]
        )
        inputs = model.input
        x = inputs
        # Rebuild the path from input through augmentation/preprocessing,
        # then obtain the nested backbone's feature and final prediction.
        for layer in model.layers:
            if layer.name == outer_name:
                break
            if layer.name != "image":
                x = layer(x)
        with tf.GradientTape() as tape:
            conv_output, backbone_output = feature_model(x)
            z = backbone_output
            # Continue from backbone output through classifier head.
            passed_backbone = False
            for layer in model.layers:
                if layer.name == outer_name:
                    passed_backbone = True
                    continue
                if passed_backbone:
                    z = layer(z)
            if class_index is None:
                class_index = tf.argmax(z[0])
            score = z[:, class_index]
            grads = tape.gradient(score, conv_output)
    else:
        conv_layer = model.get_layer(target)
        grad_model = tf.keras.Model(
            model.inputs, [conv_layer.output, model.output]
        )
        with tf.GradientTape() as tape:
            conv_output, predictions = grad_model(image_batch, training=False)
            if class_index is None:
                class_index = tf.argmax(predictions[0])
            score = predictions[:, class_index]
            grads = tape.gradient(score, conv_output)

    pooled_grads = tf.reduce_mean(grads, axis=(0, 1, 2))
    conv_output = conv_output[0]
    heatmap = tf.reduce_sum(conv_output * pooled_grads, axis=-1)
    heatmap = tf.maximum(heatmap, 0)
    maximum = tf.reduce_max(heatmap)
    heatmap = tf.where(maximum > 0, heatmap / maximum, heatmap)
    return heatmap.numpy()


def save_gradcam_examples(dataset_name, data, model_key, max_examples=8):
    model = MODEL_REGISTRY[(dataset_name, model_key)]
    out_dir = Path(GRADCAM_DIR) / dataset_name / model_key
    out_dir.mkdir(parents=True, exist_ok=True)
    saved = 0

    for images, labels in data["test"]:
        probs = model.predict(images, verbose=0)
        for i in range(images.shape[0]):
            if saved >= max_examples:
                return
            image = images[i].numpy().astype(np.uint8)
            true_idx = int(labels[i].numpy())
            pred_idx = int(np.argmax(probs[i]))
            heatmap = gradcam_heatmap(model, images[i:i+1], pred_idx)
            heatmap = cv2.resize(
                heatmap, (image.shape[1], image.shape[0])
            )
            heatmap_uint8 = np.uint8(255 * heatmap)
            colored = cv2.applyColorMap(heatmap_uint8, cv2.COLORMAP_JET)
            overlay = cv2.addWeighted(image, 0.60, colored, 0.40, 0)

            fig, axes = plt.subplots(1, 3, figsize=(12, 4))
            axes[0].imshow(image)
            axes[0].set_title("Original")
            axes[1].imshow(heatmap, cmap="jet")
            axes[1].set_title("Grad-CAM")
            axes[2].imshow(overlay)
            axes[2].set_title(
                f"True: {data['classes'][true_idx]}\n"
                f"Pred: {data['classes'][pred_idx]}"
            )
            for ax in axes:
                ax.axis("off")
            plt.tight_layout()
            plt.savefig(
                out_dir / f"gradcam_{saved:03d}.png",
                dpi=250, bbox_inches="tight"
            )
            plt.close()
            saved += 1


