def load_lime_dependencies():
    try:
        from lime import lime_image
        from skimage.segmentation import mark_boundaries
        return lime_image, mark_boundaries
    except ImportError as exc:
        raise ImportError(
            "LIME is optional. Install with: pip install lime scikit-image"
        ) from exc


def explain_with_lime(dataset_name, data, model_key, max_examples=5):
    lime_image, mark_boundaries = load_lime_dependencies()
    model = MODEL_REGISTRY[(dataset_name, model_key)]
    explainer = lime_image.LimeImageExplainer(random_state=SEED)
    out_dir = Path(LIME_DIR) / dataset_name / model_key
    out_dir.mkdir(parents=True, exist_ok=True)

    def predict_fn(images):
        images = np.asarray(images, dtype=np.float32)
        return model.predict(images, verbose=0)

    saved = 0
    for images, labels in data["test"]:
        for i in range(images.shape[0]):
            if saved >= max_examples:
                return
            image = images[i].numpy().astype(np.uint8)
            explanation = explainer.explain_instance(
                image.astype(np.double),
                classifier_fn=predict_fn,
                top_labels=1,
                hide_color=0,
                num_samples=LIME_NUM_SAMPLES
            )
            label = int(explanation.top_labels[0])
            temp, mask = explanation.get_image_and_mask(
                label, positive_only=True, num_features=8,
                hide_rest=False
            )
            fig, axes = plt.subplots(1, 2, figsize=(9, 4))
            axes[0].imshow(image)
