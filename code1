# ============================================================
# 1. BLOCK 10 CONFIGURATION
# ============================================================

BLOCK10_MAX_TEST_SAMPLES = 30

BLOCK10_OCCLUSION_GRID = 4

BLOCK10_OCCLUSION_FRACTION = 0.20

BLOCK10_EPSILON = 1e-10

BLOCK10_RESULTS = []

BLOCK10_MODEL_CACHE = {}

# ============================================================
# 2. RESOLVE TRAINED MODEL
# ============================================================

def block10_get_model(dataset_name, model_name):

    # First, check the nested dictionary structure.
    if dataset_name in TRAINED_MODELS:

        dataset_models = TRAINED_MODELS[dataset_name]

        if isinstance(dataset_models, dict):

            if model_name in dataset_models:

                return dataset_models[model_name]

    # Check tuple-based keys.
    tuple_key = (dataset_name, model_name)

    if tuple_key in TRAINED_MODELS:

        return TRAINED_MODELS[tuple_key]

    # Check combined string keys.
    combined_key = f"{dataset_name}_{model_name}"

    if combined_key in TRAINED_MODELS:

        return TRAINED_MODELS[combined_key]

    # EfficientNetB5 Grad-CAM and LIME are the same classifier.
    # Reuse the trained classifier if only one alias is stored.
    if model_name == "EfficientNetB5_GradCAM":

        alternative = "EfficientNetB5_LIME"

    elif model_name == "EfficientNetB5_LIME":

        alternative = "EfficientNetB5_GradCAM"

    else:

        alternative = None

    if alternative:

        if dataset_name in TRAINED_MODELS:

            dataset_models = TRAINED_MODELS[dataset_name]

            if isinstance(dataset_models, dict):

                if alternative in dataset_models:

                    return dataset_models[alternative]

        alternative_key = f"{dataset_name}_{alternative}"

        if alternative_key in TRAINED_MODELS:

            return TRAINED_MODELS[alternative_key]

    raise KeyError(
        f"Trained model not found for "
        f"{dataset_name}/{model_name}. "
        f"Check how Block 3-9 stores TRAINED_MODELS."
    )

# ============================================================
# 3. NORMALIZE MODEL OUTPUTS INTO PROBABILITIES
# ============================================================

def block10_to_probabilities(model_output):

    if isinstance(model_output, dict):

        model_output = next(iter(model_output.values()))

    elif isinstance(model_output, (tuple, list)):

        model_output = model_output[0]

    probabilities = np.asarray(
        model_output,
        dtype=np.float64
    )

    if probabilities.ndim == 1:

        probabilities = probabilities.reshape(1, -1)

    if probabilities.ndim != 2:

        raise ValueError(
            "Model output must have shape "
            "(batch_size, number_of_classes)."
        )

    # Handle logits or already-normalized probabilities.
    row_sums = probabilities.sum(axis=1)

    is_probability = (
        np.all(probabilities >= 0)
        and np.all(probabilities <= 1)
        and np.allclose(row_sums, 1.0, atol=1e-3)
    )

    if not is_probability:

        probabilities = probabilities - np.max(
            probabilities,
            axis=1,
            keepdims=True
        )

        exp_values = np.exp(probabilities)

        probabilities = exp_values / np.sum(
            exp_values,
            axis=1,
            keepdims=True
        )

    probabilities = np.clip(
        probabilities,
        BLOCK10_EPSILON,
        1.0
    )

    probabilities = probabilities / probabilities.sum(
        axis=1,
        keepdims=True
    )

    return probabilities

# ============================================================
# 4. GENERATE MODEL PREDICTIONS
# ============================================================

def block10_predict(model, images):

    predictions = model.predict(
        images,
        verbose=0
    )

    return block10_to_probabilities(
        predictions
    )

# ============================================================
# 5. CALCULATE PREDICTIVE UNCERTAINTY METRICS
# ============================================================

def block10_uncertainty_metrics(
    probabilities,
    true_labels
):

    probabilities = np.asarray(
        probabilities,
        dtype=np.float64
    )

    true_labels = np.asarray(
        true_labels,
        dtype=np.int64
    )

    number_of_classes = probabilities.shape[1]

    predicted_labels = np.argmax(
        probabilities,
        axis=1
    )

    # Predictive entropy in nats.
    entropy = -np.sum(
        probabilities * np.log(probabilities),
        axis=1
    )

    # Normalize entropy to [0, 1].
    if number_of_classes > 1:

        normalized_entropy = entropy / np.log(
            number_of_classes
        )

    else:

        normalized_entropy = np.zeros_like(
            entropy
        )

    # Confidence of the predicted class.
    confidence = np.max(
        probabilities,
        axis=1
    )

    # Confidence assigned to the correct class.
    true_class_confidence = probabilities[
        np.arange(len(true_labels)),
        true_labels
    ]

    # Difference between the two largest probabilities.
    sorted_probabilities = np.sort(
        probabilities,
        axis=1
    )

    prediction_margin = (
        sorted_probabilities[:, -1]
        - sorted_probabilities[:, -2]
        if number_of_classes > 1
        else np.ones(len(probabilities))
    )

    accuracy = np.mean(
        predicted_labels == true_labels
    )

    return {

        "accuracy": float(accuracy),

        "predictive_entropy": float(
            np.mean(entropy)
        ),

        "normalized_entropy": float(
            np.mean(normalized_entropy)
        ),

        "prediction_confidence": float(
            np.mean(confidence)
        ),

        "true_class_confidence": float(
            np.mean(true_class_confidence)
        ),

        "prediction_margin": float(
            np.mean(prediction_margin)
        )

    }

# ============================================================
# 6. OCCLUSION-BASED COMPREHENSIVENESS PROXY
# ============================================================

def block10_comprehensiveness(
    model,
    images,
    probabilities,
    max_samples=30
):

    """
    Estimates comprehensiveness using occlusion sensitivity.

    Procedure:
      1. Obtain the original predicted-class probability.
      2. Mask image patches one at a time.
      3. Rank patches by their effect on confidence.
      4. Remove the most influential patches.
      5. Measure the confidence reduction.

    This is an occlusion-derived proxy, not a direct
    evaluation of Grad-CAM, LIME or SHAP maps.
    """

    scores = []

    sample_count = min(
        len(images),
        max_samples
    )

    grid_size = BLOCK10_OCCLUSION_GRID

    patch_fraction = BLOCK10_OCCLUSION_FRACTION

    for sample_index in range(sample_count):

        image = np.asarray(
            images[sample_index],
            dtype=np.float32
        )

        original_probability = probabilities[
            sample_index
        ]

        target_class = int(
            np.argmax(original_probability)
        )

        original_confidence = float(
            original_probability[target_class]
        )

        height, width = image.shape[:2]

        patch_height = max(
            1,
            height // grid_size
        )

        patch_width = max(
            1,
            width // grid_size
        )

        # Use the image mean as the neutral occlusion value.
        replacement_value = float(
            np.mean(image)
        )

        patch_effects = []

        # Measure the effect of masking each patch.
        for row in range(grid_size):

            for column in range(grid_size):

                y1 = row * patch_height

                y2 = (
                    height
                    if row == grid_size - 1
                    else min(
                        (row + 1) * patch_height,
                        height
                    )
                )

                x1 = column * patch_width

                x2 = (
                    width
                    if column == grid_size - 1
                    else min(
                        (column + 1) * patch_width,
                        width
                    )
                )

                occluded_image = image.copy()

                occluded_image[
                    y1:y2,
                    x1:x2,
                    :
                ] = replacement_value

                occluded_probability = block10_predict(
                    model,
                    np.expand_dims(
                        occluded_image,
                        axis=0
                    )
                )[0, target_class]

                confidence_drop = (
                    original_confidence
                    - float(occluded_probability)
                )

                patch_effects.append({

                    "drop": confidence_drop,

                    "coordinates": (
                        y1,
                        y2,
                        x1,
                        x2
                    )

                })

        # Rank patches by their influence on the prediction.
        patch_effects.sort(
            key=lambda item: item["drop"],
            reverse=True
        )

        total_patches = len(
            patch_effects
        )

        number_to_remove = max(
            1,
            int(np.ceil(
                total_patches * patch_fraction
            ))
        )

        # Remove the most influential patches together.
        comprehensiveness_image = image.copy()

        for patch in patch_effects[:number_to_remove]:

            y1, y2, x1, x2 = patch["coordinates"]

            comprehensiveness_image[
                y1:y2,
                x1:x2,
                :
            ] = replacement_value

        final_probability = block10_predict(
            model,
            np.expand_dims(
                comprehensiveness_image,
                axis=0
            )
        )[0, target_class]

        comprehensiveness_score = (
            original_confidence
            - float(final_probability)
        )

        scores.append(
            comprehensiveness_score
        )

    if not scores:

        return np.nan

    return float(
        np.mean(scores)
    )

