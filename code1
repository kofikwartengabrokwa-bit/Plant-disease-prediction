def load_manifest_json(manifest_path):

    manifest_path = Path(manifest_path)

    with open(
        manifest_path,
        "r",
        encoding="utf-8-sig"
    ) as file:

        manifest_data = json.load(file)

    if not isinstance(manifest_data, (dict, list)):

        raise ValueError(
            f"Unexpected JSON root structure in {manifest_path}"
        )

    return manifest_data


def load_dataset_manifests():

    manifests = {}

    for dataset_key, dataset_info in DATASETS.items():

        if not dataset_info["enabled"]:
            continue

        manifest_path = dataset_info["manifest"]

        manifests[dataset_key] = load_manifest_json(
            manifest_path
        )

        LOGGER.info(
            "%s manifest loaded successfully.",
            dataset_info["name"]
        )

        LOGGER.info(
            "Manifest root type: %s",
            type(manifests[dataset_key]).__name__
        )

    return manifests


