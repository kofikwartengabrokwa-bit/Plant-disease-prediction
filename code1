def inspect_json_structure(
    obj,
    level=0,
    max_level=5
):

    indentation = "  " * level

    if level > max_level:

        return indentation + "Maximum inspection depth reached"

    if isinstance(obj, dict):

        output = []

        output.append(
            indentation + f"Dictionary with {len(obj)} keys"
        )

        for key, value in list(obj.items())[:20]:

            output.append(
                indentation + f"- {repr(key)}: "
                f"{type(value).__name__}"
            )

            if isinstance(value, (dict, list)):

                output.append(
                    inspect_json_structure(
                        value,
                        level + 1,
                        max_level
                    )
                )

            elif isinstance(value, str):

                output.append(
                    indentation + "  Value preview: "
                    + repr(value[:150])
                )

        return "\n".join(output)

    elif isinstance(obj, list):

        output = []

        output.append(
            indentation + f"List with {len(obj)} elements"
        )

        for index, value in enumerate(
            obj[:MANIFEST_PREVIEW_ITEMS]
        ):

            output.append(
                indentation + f"- Element {index}: "
                f"{type(value).__name__}"
            )

            if isinstance(value, (dict, list)):

                output.append(
                    inspect_json_structure(
                        value,
                        level + 1,
                        max_level
                    )
                )

            else:

                output.append(
                    indentation + "  Value: "
                    + repr(value)[:200]
                )

        return "\n".join(output)

    else:

        return (
            indentation
            + f"Value type: {type(obj).__name__}"
        )


