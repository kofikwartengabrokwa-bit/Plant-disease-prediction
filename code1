# ============================================================
# 13. STRATIFIED DATASET SPLITTING
# ============================================================

def split_dataset_dataframe(
    dataframe,
    dataset_name
):

    if dataframe.empty:

        raise ValueError(
            f"{dataset_name} dataframe is empty."
        )

    class_counts = dataframe["label"].value_counts()

    if len(class_counts) < 2:

        raise ValueError(
            f"{dataset_name} requires at least two classes."
        )

    if STRATIFIED_SPLITTING:

        if class_counts.min() < 3:

            raise ValueError(
                f"{dataset_name} has a class with fewer than "
                "three images. A stratified 70/15/15 split "
                "cannot be reliably created. Inspect the "
                "dataset before changing the split strategy."
            )

        train_df, temporary_df = train_test_split(

            dataframe,

            test_size=(VALIDATION_SPLIT + TEST_SPLIT),

            random_state=SEED,

            stratify=dataframe["label"]

        )

        relative_test_size = (
            TEST_SPLIT /
            (VALIDATION_SPLIT + TEST_SPLIT)
        )

        validation_df, test_df = train_test_split(

            temporary_df,

            test_size=relative_test_size,

            random_state=SEED,

            stratify=temporary_df["label"]

        )

    else:

        train_df, temporary_df = train_test_split(

            dataframe,

            test_size=(VALIDATION_SPLIT + TEST_SPLIT),

            random_state=SEED

        )

        relative_test_size = (
            TEST_SPLIT /
            (VALIDATION_SPLIT + TEST_SPLIT)
        )

        validation_df, test_df = train_test_split(

            temporary_df,

            test_size=relative_test_size,

            random_state=SEED

        )

    train_df = train_df.reset_index(drop=True)

    validation_df = validation_df.reset_index(drop=True)

    test_df = test_df.reset_index(drop=True)

    print(
        f"\n{dataset_name.upper()} SPLIT SUMMARY"
    )

    print("-" * 60)

    print(
        f"Training:   {len(train_df):6d} "
        f"({len(train_df) / len(dataframe):.2%})"
    )

    print(
        f"Validation: {len(validation_df):6d} "
        f"({len(validation_df) / len(dataframe):.2%})"
    )

    print(
        f"Testing:    {len(test_df):6d} "
        f"({len(test_df) / len(dataframe):.2%})"
    )

    return {

        "train": train_df,

        "validation": validation_df,

        "test": test_df

    }


