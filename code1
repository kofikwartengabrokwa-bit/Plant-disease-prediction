# BLOCK 5. TRAINING, OPTIONAL FINE-TUNING AND ENSEMBLE
# ------------------------------------------------------------

def fit_one_model(dataset_name, model_key, model, data):
    trainable, non_trainable, total = count_parameters(model)
    weights = make_class_weights(data["train_dataframe"], data["num_classes"])

    start = time.perf_counter()
    history = model.fit(
        data["train"],
        validation_data=data["validation"],
        epochs=EPOCHS,
        class_weight=weights if USE_CLASS_WEIGHTS else None,
        callbacks=callbacks_for(dataset_name, model_key),
        verbose=1
    )
    training_seconds = time.perf_counter() - start

    # Optional fine-tuning of the final backbone layers.
    backbone = getattr(model, "backbone", None)
    if FINE_TUNE_APPLICATIONS and backbone is not None:
        backbone.trainable = True
        for layer in backbone.layers[:-APPLICATION_FINE_TUNE_LAYERS]:
            layer.trainable = False
        model.compile(
            optimizer=tf.keras.optimizers.AdamW(
                learning_rate=LEARNING_RATE * 0.1,
                weight_decay=WEIGHT_DECAY
            ),
            loss="sparse_categorical_crossentropy",
            metrics=["accuracy"]
        )
        fine_history = model.fit(
            data["train"],
            validation_data=data["validation"],
            epochs=max(5, EPOCHS // 4),
            class_weight=weights if USE_CLASS_WEIGHTS else None,
            callbacks=callbacks_for(dataset_name, model_key + "_finetuned"),
            verbose=1
        )
        training_seconds += sum(fine_history.history.get("loss", [])) * 0.0
        # Use the best checkpoint from the fine-tuning phase if it exists.
        fine_path = model_file(dataset_name, model_key + "_finetuned")
        if fine_path.exists():
            model = tf.keras.models.load_model(fine_path)

    # Load best first-stage checkpoint if fine-tuning checkpoint absent.
    first_path = model_file(dataset_name, model_key)
    if first_path.exists():
        candidate = tf.keras.models.load_model(first_path)
        # The first checkpoint is guaranteed to be a valid saved model.
        # Prefer fine-tuned model only when its checkpoint exists.
        fine_path = model_file(dataset_name, model_key + "_finetuned")
        model = (tf.keras.models.load_model(fine_path)
                 if fine_path.exists() else candidate)

    MODEL_REGISTRY[(dataset_name, model_key)] = model
    TRAINING_RECORDS.append({
        "dataset": dataset_name,
        "model": model_key,
        "training_time_seconds": float(training_seconds),
        "trainable_parameters": int(trainable),
        "non_trainable_parameters": int(non_trainable),
        "total_parameters": int(total),
        "best_validation_accuracy": float(max(history.history.get(
            "val_accuracy", [np.nan]
        ))),
        "epochs_completed": int(len(history.history.get("loss", [])))
    })
    return model, history


def predict_model(model, tf_dataset):
    y_true, y_prob = [], []
    for images, labels in tf_dataset:
        probabilities = model.predict(images, verbose=0)
        y_prob.append(probabilities)
        y_true.append(labels.numpy())
    return np.concatenate(y_true), np.concatenate(y_prob)


def train_experiment_models(dataset_name, data):
    num_classes = data["num_classes"]
    histories = {}

    # Proposed model.
    model, histories["CNN_MHA"] = fit_one_model(
        dataset_name, "CNN_MHA",
        build_cnn_mha(num_classes), data
    )

    # B1 and B2 intentionally share the same trained classifier.
    efficientnet, histories["EfficientNetB5"] = fit_one_model(
        dataset_name, "EfficientNetB5",
        build_efficientnet_b5(num_classes), data
    )
    MODEL_REGISTRY[(dataset_name, "EfficientNetB5_GradCAM")] = efficientnet
    MODEL_REGISTRY[(dataset_name, "EfficientNetB5_LIME")] = efficientnet

    # B3 constituent networks. Average their predicted class probabilities.
    ensemble_members = {}
    for architecture in ["VGG16", "VGG19", "ResNet101V2", "InceptionV3"]:
        member, histories[architecture] = fit_one_model(
            dataset_name, architecture,
            build_application_classifier(architecture, num_classes), data
        )
        ensemble_members[architecture] = member

    MODEL_REGISTRY[(dataset_name, "Four_Model_Ensemble_LIME")] = ensemble_members

    # B4.
    resnet9, histories["ResNet9"] = fit_one_model(
        dataset_name, "ResNet9",
        build_resnet9(num_classes), data
    )
    MODEL_REGISTRY[(dataset_name, "ResNet9_SHAP")] = resnet9

    return histories


def predict_experiment_model(dataset_name, model_key, test_dataset):
    model = MODEL_REGISTRY[(dataset_name, model_key)]
    if isinstance(model, dict):
        member_probabilities = []
        y_true = None
        for member in model.values():
            current_y, current_prob = predict_model(member, test_dataset)
            if y_true is None:
                y_true = current_y
            elif not np.array_equal(y_true, current_y):
                raise RuntimeError("Ensemble members produced different label order.")
            member_probabilities.append(current_prob)
        return y_true, np.mean(member_probabilities, axis=0)
    return predict_model(model, test_dataset)


