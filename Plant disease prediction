@torch.inference_mode()
def predict_batch(model, images):

    images = images.to(DEVICE)

    logits = extract_logits(
        model(images)
    )

    probabilities = F.softmax(
        logits,
        dim=1
    )

    return probabilities.detach().cpu().numpy()

