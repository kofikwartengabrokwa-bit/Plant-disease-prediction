def normalize_class_name(name):
    """Normalize label formatting without changing its meaning."""
    return str(name).strip().lower().replace("_", " ").replace("-", " ")


def load_checkpoint(checkpoint_path):
    if not checkpoint_path.exists():
        raise FileNotFoundError(
            f"Checkpoint not found: {checkpoint_path}"
        )

    try:
        checkpoint = torch.load(
            checkpoint_path,
            map_location=DEVICE,
            weights_only=False
        )
    except TypeError:
        checkpoint = torch.load(
            checkpoint_path,
            map_location=DEVICE
        )

    if not isinstance(checkpoint, dict):
        raise ValueError("Checkpoint must contain a dictionary.")

    if "class_names" not in checkpoint:
        raise KeyError(
            f"'class_names' missing from {checkpoint_path.name}"
        )

    state_dict = checkpoint.get(
        "model_state_dict",
        checkpoint.get("state_dict")
    )

    if state_dict is None:
        raise KeyError(
            f"No model_state_dict or state_dict in "
            f"{checkpoint_path.name}"
        )

    return checkpoint, state_dict


def read_test_manifest(dataset_name):
    manifest_path = (
        MANIFEST_DIR / dataset_name / "split_manifest.csv"
    )

    if not manifest_path.exists():
        raise FileNotFoundError(
            f"Manifest not found: {manifest_path}"
        )

    df = pd.read_csv(manifest_path)

    required_columns = {
        "image_path",
        "class_name",
        "split"
    }

    missing = required_columns - set(df.columns)

    if missing:
        raise ValueError(
            f"{manifest_path.name} is missing columns: {missing}"
        )

    test_df = df[
        df["split"].astype(str).str.lower().eq("test")
    ].copy()

    test_df["class_name"] = (
        test_df["class_name"].astype(str).str.strip()
    )

    test_df["normalized_class"] = (
        test_df["class_name"].apply(normalize_class_name)
    )

    if test_df.empty:
        raise ValueError(
            f"No test images found for {dataset_name}."
        )

    return test_df


def resolve_image_path(image_path, dataset_name):
    path = Path(str(image_path))

    if path.is_absolute():
        return path

    candidates = [
        PROJECT_DIR / path,
        DATA_DIR / dataset_name / path,
        MANIFEST_DIR / dataset_name / path
    ]

    for candidate in candidates:
        if candidate.exists():
            return candidate

    return candidates[0]


def make_transform(image_size):
    return transforms.Compose([
        transforms.Resize(
            (image_size, image_size)
        ),
        transforms.ToTensor(),
        transforms.Normalize(
            mean=[0.485, 0.456, 0.406],
            std=[0.229, 0.224, 0.225]
        )
    ])


def make_compatible_class_mapping(
    source_classes,
    target_classes
):
    """
    Returns target class -> source model output index.

    Exact normalized label matches are used by default.
    Explicit mappings can be added only after semantic
    equivalence has been verified.
    """

    source_lookup = {
        normalize_class_name(name): idx
        for idx, name in enumerate(source_classes)
    }

    target_to_source = {}

    for target_name in target_classes:
        normalized_target = normalize_class_name(target_name)

        if normalized_target in source_lookup:
            target_to_source[target_name] = (
                source_lookup[normalized_target]
            )
            continue

        mapped_source_name = (
            TARGET_TO_SOURCE_CLASS_MAPPING.get(target_name)
        )

        if mapped_source_name is not None:
            normalized_source = normalize_class_name(
                mapped_source_name
            )

            if normalized_source not in source_lookup:
                raise ValueError(
                    f"Mapped source class '{mapped_source_name}' "
                    f"is not in checkpoint classes: {source_classes}"
                )

            target_to_source[target_name] = (
                source_lookup[normalized_source]
            )

    return target_to_source


