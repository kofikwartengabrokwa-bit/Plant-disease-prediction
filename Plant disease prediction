    )

    required_columns = [
        "actual_class",
        "predicted_class",
        "confidence",
        "correct"
    ]

    missing = [
        col for col in required_columns
        if col not in df.columns
    ]

    if missing:

        raise KeyError(
            f"Missing prediction columns in "
            f"{prediction_file}: {missing}"
        )

    probability_columns = [
        col for col in df.columns
        if col.startswith("probability_")
    ]

    if len(probability_columns) < 2:

        raise ValueError(
            f"At least two probability columns are required "
            f"in {prediction_file}"
        )

    probabilities = df[
        probability_columns
    ].to_numpy(dtype=np.float64)

    if not np.isfinite(probabilities).all():

        raise ValueError(
            f"Non-finite probabilities in {prediction_file}"
        )

    if (
        probabilities.min() < -1e-8
        or probabilities.max() > 1.0 + 1e-8
    ):

        raise ValueError(
            f"Probabilities outside [0,1] in {prediction_file}"
        )

    row_sums = probabilities.sum(
        axis=1
    )

    if np.any(row_sums <= 0):

        raise ValueError(
            "Invalid probability row with zero sum."
        )

    # Normalize small numerical deviations.
    probabilities = (
        probabilities /
        row_sums[:, None]
    )

    class_names = [
        col.replace("probability_", "", 1)
        for col in probability_columns
    ]

    if df["actual_class"].isna().any():

        raise ValueError(
            "Missing actual class labels."
        )

    if not set(
        df["actual_class"].astype(str)
    ).issubset(set(class_names)):

        raise ValueError(
            "Actual class labels do not match "
            "probability columns."
        )

    return df, probabilities, class_names


# ============================================================
# 4. CONVERT ACTUAL LABELS TO NUMERIC INDICES
# ============================================================

def encode_labels(
    actual_labels,
    class_names
):

    class_to_index = {
        name: index
        for index, name in enumerate(class_names)
    }

    return np.asarray([
        class_to_index[str(label)]
        for label in actual_labels
    ], dtype=int)


# ============================================================
# 5. EXPECTED CALIBRATION ERROR (ECE)
# ============================================================

def calculate_ece(
    probabilities,
    actual_labels,
    number_of_bins=15
):

    predicted_labels = np.argmax(
        probabilities,
        axis=1
    )

    confidence = np.max(
        probabilities,
        axis=1
    )

    correct = (
        predicted_labels == actual_labels
    ).astype(float)

    bin_edges = np.linspace(
        0,
        1,
        number_of_bins + 1
    )

    ece = 0.0
    mce = 0.0

    bin_results = []

    for bin_index in range(number_of_bins):

        lower = bin_edges[bin_index]
        upper = bin_edges[bin_index + 1]

        if bin_index == number_of_bins - 1:

            mask = (
                (confidence >= lower)
                & (confidence <= upper)
            )

        else:

            mask = (
                (confidence >= lower)
                & (confidence < upper)
            )

        bin_count = int(
            np.sum(mask)
        )

        if bin_count == 0:

            bin_results.append({

                "bin": bin_index + 1,
                "lower_bound": lower,
                "upper_bound": upper,
                "sample_count": 0,
                "mean_confidence": np.nan,
                "observed_accuracy": np.nan,
                "calibration_gap": np.nan

            })

            continue

        bin_confidence = float(
            np.mean(confidence[mask])
        )

        bin_accuracy = float(
            np.mean(correct[mask])
        )

        calibration_gap = abs(
            bin_accuracy - bin_confidence
        )

        bin_weight = (
            bin_count /
            len(confidence)
        )

        ece += (
            bin_weight *
            calibration_gap
        )

        mce = max(
            mce,
            calibration_gap
        )

        bin_results.append({

            "bin": bin_index + 1,
            "lower_bound": lower,
            "upper_bound": upper,
            "sample_count": bin_count,
            "mean_confidence": bin_confidence,
            "observed_accuracy": bin_accuracy,
            "calibration_gap": calibration_gap

        })

    return ece, mce, pd.DataFrame(
        bin_results
    )


# ============================================================
# 6. MULTICLASS BRIER SCORE
# ============================================================

def calculate_multiclass_brier(
    probabilities,
    actual_labels
):

    number_of_classes = probabilities.shape[1]

    one_hot = np.eye(
        number_of_classes
    )[actual_labels]

    squared_error = np.sum(
        (probabilities - one_hot) ** 2,
        axis=1
    )

    # Divide by the number of classes to obtain
    # the normalized multiclass Brier score.
    brier_score = np.mean(
        squared_error
    ) / number_of_classes

    return float(brier_score)


# ============================================================
# 7. NEGATIVE LOG-LIKELIHOOD
# ============================================================

def calculate_nll(
    probabilities,
    actual_labels
):

    probabilities = np.clip(
        probabilities,
        DEVICE_EPSILON,
        1.0 - DEVICE_EPSILON
    )

    probabilities = (
        probabilities /
        probabilities.sum(
            axis=1,
            keepdims=True
        )
    )

    return float(
        -np.mean(
            np.log(
                probabilities[
                    np.arange(len(actual_labels)),
                    actual_labels
                ]
            )
        )
    )


# ============================================================
# 8. ADDITIONAL CALIBRATION METRICS
# ============================================================

def calculate_calibration_metrics(
    probabilities,
    actual_labels
):

    predicted_labels = np.argmax(
        probabilities,
        axis=1
    )

    confidence = np.max(
        probabilities,
        axis=1
    )

    correct = (
        predicted_labels == actual_labels
    )

    ece, mce, bin_df = calculate_ece(
        probabilities,
        actual_labels,
        NUMBER_OF_BINS
    )

    brier = calculate_multiclass_brier(
        probabilities,
        actual_labels
    )

    nll = calculate_nll(
        probabilities,
        actual_labels
    )

    return {

        "accuracy": float(
            np.mean(correct)
        ),

        "mean_confidence": float(
            np.mean(confidence)
        ),

        "ece": ece,

        "mce": mce,

        "brier_score": brier,

        "negative_log_likelihood": nll,

        "correct_prediction_confidence": (
            float(np.mean(confidence[correct]))
            if np.any(correct)
            else np.nan
        ),

        "incorrect_prediction_confidence": (
            float(np.mean(confidence[~correct]))
            if np.any(~correct)
            else np.nan
        ),

        "number_of_correct_predictions": int(
            np.sum(correct)
        ),

        "number_of_incorrect_predictions": int(
            np.sum(~correct)
        )

    }, bin_df


