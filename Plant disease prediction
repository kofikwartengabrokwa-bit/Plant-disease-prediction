def preprocess_image(
    image_path,
    output_path
):

    """
    Deterministic image preprocessing.

    Operations:
        1. Read original image.
        2. Convert to RGB.
        3. Resize to 224 x 224.
        4. Save as JPEG.

    No augmentation is performed here.
    """

    with Image.open(image_path) as image:

        image.load()

        original_width, original_height = image.size

        original_mode = image.mode

        # Convert all images into RGB

        image = image.convert("RGB")

        # Standardize image dimensions

        image = image.resize(

            (IMAGE_SIZE, IMAGE_SIZE),

            resample=Image.Resampling.BICUBIC

        )

        # Verify output dimensions

        if image.size != (IMAGE_SIZE, IMAGE_SIZE):

            raise ValueError(
                "Incorrect image dimensions after resizing."
            )

        # Save standardized image

        output_path.parent.mkdir(
            parents=True,
            exist_ok=True
        )

        image.save(

            output_path,

            format=IMAGE_FORMAT,

            quality=IMAGE_QUALITY,

            optimize=True

        )

    return {

        "original_width": original_width,

        "original_height": original_height,

        "original_mode": original_mode,

        "processed_width": IMAGE_SIZE,

        "processed_height": IMAGE_SIZE,

        "processed_mode": "RGB"

    }


