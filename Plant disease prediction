def create_ensemble_predict_function(model):

    def predict_images(images):

        tensor_list = []

        for image in images:

            pil_image = Image.fromarray(
                np.uint8(
                    np.clip(image, 0, 255)
                )
            ).convert("RGB")

            pil_image = pil_image.resize(
                (IMAGE_SIZE, IMAGE_SIZE)
            )

            tensor = transforms.ToTensor()(pil_image)

            tensor = normalization(tensor)

            tensor_list.append(tensor)

        all_probabilities = []

        with torch.no_grad():

            for start in range(
                0,
                len(tensor_list),
                BATCH_SIZE
            ):

                batch = torch.stack(
                    tensor_list[
                        start:start + BATCH_SIZE
                    ]
                ).to(DEVICE)

                outputs = model(batch)

                if isinstance(outputs, (tuple, list)):

                    outputs = outputs[0]

                # Block 7 ensemble returns log probabilities.
                # Convert to probabilities for LIME.
                if (
                    outputs.min().item() < 0
                    and outputs.max().item() <= 0
                ):

                    probabilities = torch.exp(outputs)

                else:

                    probabilities = torch.softmax(
                        outputs,
                        dim=1
                    )

                all_probabilities.append(
                    probabilities.cpu().numpy()
                )

        return np.concatenate(
            all_probabilities,
            axis=0
        )

    return predict_images


