def get_model_logits(outputs):

    # The Block 7 ensemble is expected to return
    # log probabilities from soft voting.
    #
    # CrossEntropyLoss accepts these log probabilities
    # as inputs, so no additional softmax is required.

    if isinstance(outputs, (tuple, list)):

        outputs = outputs[0]

    if not torch.is_tensor(outputs):

        raise TypeError(
            "Ensemble model must return a tensor "
            "or a tuple/list containing a tensor."
        )

    return outputs


# ------------------------------------------------------------
# 10. TRAINING AND VALIDATION
# ------------------------------------------------------------

def run_epoch(
    model,
    loader,
    criterion,
    optimizer=None
):

    training = optimizer is not None

    if training:

        model.train()

    else:

        model.eval()

    total_loss = 0.0

    total_correct = 0

    total_samples = 0

    accumulation_steps = (
        GRADIENT_ACCUMULATION_STEPS
        if training else 1
    )

    if training:

        optimizer.zero_grad(set_to_none=True)

    for batch_index, (images, labels) in enumerate(loader):

        images = images.to(DEVICE)

        labels = labels.to(DEVICE)

        with torch.set_grad_enabled(training):

            outputs = model(images)

            logits = get_model_logits(outputs)

            loss = criterion(logits, labels)

            if training:

                scaled_loss = (
                    loss / accumulation_steps
                )

                scaled_loss.backward()

                # Update after the specified accumulation steps
                # or at the final batch.
                final_batch = (
                    batch_index + 1 == len(loader)
                )

                if (
                    (batch_index + 1) % accumulation_steps == 0
                    or final_batch
                ):

                    optimizer.step()

                    optimizer.zero_grad(set_to_none=True)

        batch_size = labels.size(0)

        total_loss += loss.item() * batch_size

        predictions = logits.argmax(dim=1)

        total_correct += (
            predictions == labels
        ).sum().item()

        total_samples += batch_size

    average_loss = (
        total_loss / max(total_samples, 1)
    )

    accuracy = (
        total_correct / max(total_samples, 1)
    ) * 100.0

    return average_loss, accuracy


