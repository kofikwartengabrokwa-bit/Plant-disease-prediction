def plot_training_history(
    checkpoint,
    dataset_name,
    model_name
):

    history = checkpoint.get("history")

    if not isinstance(history, dict):
        return

    aliases = {

        "accuracy": [
            "accuracy",
            "train_accuracy",
            "train_acc"
        ],

        "val_accuracy": [
            "val_accuracy",
            "validation_accuracy",
            "val_acc"
        ],

        "loss": [
            "loss",
            "train_loss"
        ],

        "val_loss": [
            "val_loss",
            "validation_loss"
        ]

    }

    history_data = {}

    for target, possible_keys in aliases.items():

        for key in possible_keys:

            if key in history:

                history_data[target] = history[key]

                break

    if not history_data:
        return

    for metric_group, keys in {

        "accuracy": [
            "accuracy",
            "val_accuracy"
        ],

        "loss": [
            "loss",
            "val_loss"
        ]

    }.items():

        available = [
            key for key in keys
            if key in history_data
        ]

        if not available:
            continue

        fig, ax = plt.subplots(
            figsize=(9, 6)
        )

        for key in available:

            values = np.asarray(
                history_data[key],
                dtype=float
            )

            ax.plot(
                np.arange(1, len(values) + 1),
                values,
                linewidth=1.8,
                label=key
            )

        ax.set_xlabel("Epoch")

        ax.set_ylabel(
            "Accuracy" if metric_group == "accuracy"
            else "Loss"
        )

        ax.set_title(
            f"{MODEL_LABELS[model_name]} - "
            f"{dataset_name.title()} "
            f"{metric_group.title()} History"
        )

        ax.legend()

        ax.grid(
            True,
            linestyle="--",
            alpha=0.4
        )

        plt.tight_layout()

        plt.savefig(
            FIGURE_DIR
            / f"{dataset_name}_{model_name}_{metric_group}_history.png",
