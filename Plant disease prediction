# 8. OCCLUSION-BASED ATTRIBUTION
# ============================================================

def create_occlusion_masks(
    image_tensor,
    grid_size=4,
    replacement_value=0.0
):

    """
    Generates one perturbed image for each image-grid region.

    Each perturbation removes one region while preserving
    the other image regions.
    """

    _, height, width = image_tensor.shape

    masks = []

    patch_height = math.ceil(
        height / grid_size
    )

    patch_width = math.ceil(
        width / grid_size
    )

    for row in range(grid_size):

        for col in range(grid_size):

            perturbed = image_tensor.clone()

            y1 = row * patch_height
            y2 = min(
                (row + 1) * patch_height,
                height
            )

            x1 = col * patch_width
            x2 = min(
                (col + 1) * patch_width,
                width
            )

            perturbed[:, y1:y2, x1:x2] = (
                replacement_value
            )

            masks.append({
                "tensor": perturbed,
                "row": row,
                "col": col
            })

    return masks

@torch.inference_mode()
def calculate_comprehensiveness(
    model,
    image_tensor,
    original_probabilities,
    grid_size=4,
    top_fraction=0.25
):

    """
    1. Occlude each image region individually.
    2. Measure the decrease in the original predicted-class
       probability.
    3. Rank regions by their measured importance.
    4. Remove the most influential regions.
    5. Calculate the original-confidence reduction.
    """

    original_class = int(
        np.argmax(original_probabilities)
    )

    original_confidence = float(
        original_probabilities[original_class]
    )

    region_masks = create_occlusion_masks(
        image_tensor,
        grid_size=grid_size,
        replacement_value=OCCLUSION_VALUE
    )

    perturbed_tensors = [
        item["tensor"]
        for item in region_masks
    ]

    region_probabilities = []

    for start in range(
        0,
        len(perturbed_tensors),
        OCCLUSION_BATCH_SIZE
    ):

        batch_tensors = perturbed_tensors[
            start:
            start + OCCLUSION_BATCH_SIZE
        ]

        batch = torch.stack(
            batch_tensors
        )

        probabilities = predict_batch(
            model,
            batch
        )

        region_probabilities.extend(
            probabilities[:, original_class].tolist()
        )

    region_probabilities = np.asarray(
        region_probabilities
    )

    # Importance is measured by confidence reduction.
    region_importance = (
        original_confidence -
        region_probabilities
    )

    number_of_regions = len(
        region_importance
    )

    number_to_remove = max(
        1,
        int(np.ceil(
            number_of_regions * top_fraction
        ))
    )

    # Select the most influential regions.
    top_indices = np.argsort(
        region_importance
    )[::-1][:number_to_remove]

    # Remove all selected regions simultaneously.
    comprehensiveness_image = image_tensor.clone()

    _, height, width = comprehensiveness_image.shape

    patch_height = math.ceil(
        height / grid_size
    )

    patch_width = math.ceil(
        width / grid_size
    )

    for index in top_indices:

        row = region_masks[index]["row"]
        col = region_masks[index]["col"]

        y1 = row * patch_height
        y2 = min(
            (row + 1) * patch_height,
            height
        )

        x1 = col * patch_width
        x2 = min(
            (col + 1) * patch_width,
            width
        )

        comprehensiveness_image[
            :,
            y1:y2,
            x1:x2
        ] = OCCLUSION_VALUE

    perturbed_probability = predict_batch(
        model,
        comprehensiveness_image.unsqueeze(0)
    )[0]

    confidence_after_removal = float(
        perturbed_probability[original_class]
    )

    comprehensiveness = (
        original_confidence -
        confidence_after_removal
    )

    return {
        "original_confidence": original_confidence,
        "confidence_after_removal": confidence_after_removal,
        "comprehensiveness": comprehensiveness,
        "removed_regions": number_to_remove,
        "total_regions": number_of_regions
    }

