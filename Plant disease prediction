# ------------------------------------------------------------
# 4. IMAGE HASHING FUNCTION
# ------------------------------------------------------------

def calculate_sha256(image_path):

    sha256 = hashlib.sha256()

    with open(image_path, "rb") as file:

        for chunk in iter(
            lambda: file.read(1024 * 1024),
            b""
        ):

            sha256.update(chunk)

    return sha256.hexdigest()


# ------------------------------------------------------------
# 5. DATASET SPLITTING FUNCTION
# ------------------------------------------------------------

def create_dataset_splits(dataset_name, config):

    print("\n" + "=" * 75)

    print(f"PROCESSING {dataset_name.upper()}")

    print("=" * 75)

    dataset_dir = (
        PROCESSED_DIR / dataset_name
    )

    if not dataset_dir.exists():

        raise FileNotFoundError(
            f"Processed dataset not found: {dataset_dir}"
        )

    # --------------------------------------------------------
    # 5.1 COLLECT IMAGE PATHS AND CLASS LABELS
    # --------------------------------------------------------

    records = []

    for class_dir in sorted(dataset_dir.iterdir()):

        if not class_dir.is_dir():

            continue

        class_name = class_dir.name

        image_paths = sorted([

            path

            for path in class_dir.rglob("*")

            if path.is_file()

            and path.suffix.lower() in {

                ".jpg",
                ".jpeg",
                ".png",
                ".bmp",
                ".webp"

            }

        ])

        for image_path in image_paths:

            records.append({

                "dataset": dataset_name,

                "image_path": str(
                    image_path.resolve()
                ),

                "class_name": class_name

            })

    df = pd.DataFrame(records)

    if df.empty:

        raise ValueError(
            f"No processed images found for {dataset_name}"
        )

    print("Total images:", len(df))

    print("Detected classes:", df["class_name"].nunique())

    # --------------------------------------------------------
    # 5.2 VALIDATE DATASET SIZE
    # --------------------------------------------------------

    if len(df) != config["expected_images"]:

        raise ValueError(

            f"{dataset_name}: Expected "
            f"{config['expected_images']} images, "
            f"but found {len(df)}."

        )

    if df["class_name"].nunique() != config["expected_classes"]:

        raise ValueError(

            f"{dataset_name}: Expected "
            f"{config['expected_classes']} classes."

        )

    # --------------------------------------------------------
    # 5.3 COMPUTE IMAGE HASHES
    # --------------------------------------------------------

    print("\nCalculating image hashes...")

    hashes = []

    for image_path in df["image_path"]:

        hashes.append(
            calculate_sha256(image_path)
        )

    df["sha256"] = hashes

    # --------------------------------------------------------
    # 5.4 IDENTIFY EXACT DUPLICATES
    # --------------------------------------------------------

    duplicate_counts = df["sha256"].value_counts()

    duplicate_hashes = duplicate_counts[
        duplicate_counts > 1
    ]

    print(
        "Unique image hashes:",
        df["sha256"].nunique()
    )

    print(
        "Duplicate hash groups:",
        len(duplicate_hashes)
    )

    print(
        "Additional duplicate copies:",
        int((duplicate_counts - 1).clip(lower=0).sum())
    )

    # A single exact image must not have conflicting labels.

    label_counts_per_hash = (
        df.groupby("sha256")["class_name"].nunique()
    )

    conflicting_hashes = label_counts_per_hash[
        label_counts_per_hash > 1
    ]

    if len(conflicting_hashes) > 0:

        conflict_report = df[
            df["sha256"].isin(conflicting_hashes.index)
        ]

        conflict_path = (
            TABLE_DIR
            / f"{dataset_name}_conflicting_duplicate_labels.csv"
        )

        conflict_report.to_csv(
            conflict_path,
            index=False
        )

        raise ValueError(

            "Identical image files have conflicting class labels. "
            "Manual inspection is required before splitting. "
            f"See: {conflict_path}"

        )

    # --------------------------------------------------------
    # 5.5 CREATE GROUP IDENTIFIERS
    # --------------------------------------------------------

    # All exact duplicate images share one group.
    # Groups are stratified using their disease labels.

    df["group_id"] = df["sha256"]

    class_group_counts = (
        df.groupby("class_name")["group_id"].nunique()
    )

    print("\nUnique groups per class:")

    print(class_group_counts)

    if class_group_counts.min() < N_SPLITS:

        raise ValueError(

            f"At least one class has fewer than {N_SPLITS} "
            "unique image groups. Reduce N_SPLITS or inspect "
            "the dataset before proceeding."

        )

    # --------------------------------------------------------
    # 5.6 STRATIFIED GROUP FOLD GENERATION
    # --------------------------------------------------------

    splitter = StratifiedGroupKFold(

        n_splits=N_SPLITS,

        shuffle=True,

        random_state=RANDOM_SEED

    )

    X = np.zeros(len(df))

    y = df["class_name"].values

    groups = df["group_id"].values

    fold_assignment = np.full(
        len(df),
        -1,
        dtype=int
    )

    for fold_number, (_, fold_indices) in enumerate(

        splitter.split(
            X,
            y,
            groups
        )

    ):

        fold_assignment[fold_indices] = fold_number

    if np.any(fold_assignment == -1):

        raise RuntimeError(
            "Some images were not assigned to a fold."
        )

    df["fold"] = fold_assignment

    # --------------------------------------------------------
    # 5.7 MAP FOLDS TO TRAIN, VALIDATION AND TEST
    # --------------------------------------------------------

    # 20 folds:
    # 3 folds -> approximately 15% test
    # 3 folds -> approximately 15% validation
    # 14 folds -> approximately 70% training

    test_folds = [0, 1, 2]

    validation_folds = [3, 4, 5]

    train_folds = list(range(6, 20))

    df["split"] = "train"

    df.loc[
        df["fold"].isin(validation_folds),
        "split"
    ] = "validation"

    df.loc[
        df["fold"].isin(test_folds),
        "split"
    ] = "test"

    # --------------------------------------------------------
    # 5.8 VERIFY GROUP SEPARATION
    # --------------------------------------------------------

    train_groups = set(
        df.loc[
            df["split"] == "train",
            "group_id"
        ]
    )

    validation_groups = set(
        df.loc[
            df["split"] == "validation",
            "group_id"
        ]
    )

    test_groups = set(
        df.loc[
            df["split"] == "test",
            "group_id"
        ]
    )

    assert train_groups.isdisjoint(validation_groups)

    assert train_groups.isdisjoint(test_groups)

    assert validation_groups.isdisjoint(test_groups)

    print("\nGROUP LEAKAGE VERIFICATION: PASSED")

    # --------------------------------------------------------
    # 5.9 CALCULATE ACTUAL SPLIT DISTRIBUTION
    # --------------------------------------------------------

    split_counts = df["split"].value_counts()

    print("\nSPLIT DISTRIBUTION")

    for split_name in SPLIT_RATIO:

        count = int(
            split_counts.get(split_name, 0)
        )

        percentage = (
            count / len(df)
        ) * 100

        print(
            f"{split_name.upper()}: "
            f"{count} images ({percentage:.2f}%)"
        )

    # --------------------------------------------------------
    # 5.10 CHECK CLASS REPRESENTATION
    # --------------------------------------------------------

    class_split_table = pd.crosstab(

        df["class_name"],

        df["split"]

    )

    class_split_table = class_split_table.reindex(

        columns=[
            "train",
            "validation",
            "test"
        ],

        fill_value=0

    )

    print("\nCLASS DISTRIBUTION ACROSS SPLITS")

    print(class_split_table)

    if (class_split_table == 0).any().any():

        raise ValueError(
            "At least one class is missing from a split."
        )

    # --------------------------------------------------------
    # 5.11 SAVE SPLIT MANIFEST
    # --------------------------------------------------------

    manifest_columns = [

        "dataset",

        "image_path",

        "class_name",

        "sha256",

        "group_id",

        "fold",

        "split"

    ]

    manifest = df[manifest_columns].copy()

    manifest_path = (

        SPLITS_DIR
        / dataset_name
        / "split_manifest.csv"

    )

    manifest.to_csv(

        manifest_path,

        index=False

    )

    # --------------------------------------------------------
    # 5.12 SAVE INDIVIDUAL SPLIT FILES
    # --------------------------------------------------------

    for split_name in SPLIT_RATIO:

        split_df = manifest[
            manifest["split"] == split_name
        ].copy()

        output_path = (

            SPLITS_DIR
            / dataset_name
            / split_name
            / f"{split_name}_manifest.csv"

        )

        split_df.to_csv(

            output_path,

            index=False

        )

    # --------------------------------------------------------
    # 5.13 SAVE CLASS DISTRIBUTION
    # --------------------------------------------------------

    class_distribution_path = (

        TABLE_DIR
        / f"{dataset_name}_split_class_distribution.csv"

    )

    class_split_table.to_csv(
        class_distribution_path
    )

    # --------------------------------------------------------
    # 5.14 VERIFY IMAGE PATHS
    # --------------------------------------------------------

    missing_paths = [

        path

        for path in manifest["image_path"]

        if not Path(path).is_file()

    ]

    if missing_paths:

        raise FileNotFoundError(

            f"{len(missing_paths)} image paths are missing."

        )

    # --------------------------------------------------------
    # 5.15 DATASET SUMMARY
    # --------------------------------------------------------

    summary = {

        "dataset": dataset_name,

        "total_images": len(df),

        "number_of_classes": int(
            df["class_name"].nunique()
        ),

        "unique_image_groups": int(
            df["group_id"].nunique()
        ),

        "duplicate_hash_groups": int(
            len(duplicate_hashes)
        ),

        "train_images": int(
            (df["split"] == "train").sum()
        ),

        "validation_images": int(
            (df["split"] == "validation").sum()
        ),

        "test_images": int(
            (df["split"] == "test").sum()
        ),

        "train_percentage": float(
            (df["split"] == "train").mean() * 100
        ),

        "validation_percentage": float(
            (df["split"] == "validation").mean() * 100
        ),

        "test_percentage": float(
            (df["split"] == "test").mean() * 100
        ),

        "group_leakage": False,

        "missing_image_paths": len(missing_paths),

        "manifest_path": str(manifest_path)

    }

    print("\nDATASET SUMMARY")

    print(
        json.dumps(
            summary,
            indent=4
        )
    )

    return manifest, class_split_table, summary


# ------------------------------------------------------------
