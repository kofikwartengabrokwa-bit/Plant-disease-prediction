def extract_logits(output):

    # Some architectures return multiple outputs.
    if isinstance(output, (tuple, list)):
        output = output[0]

    if isinstance(output, dict):

        if "logits" in output:
            output = output["logits"]

        elif "output" in output:
            output = output["output"]

        else:
            raise ValueError(
                "Model dictionary output has no logits/output key."
            )

    if not torch.is_tensor(output):
        raise TypeError(
            "The model must return a tensor of classification logits."
        )

    return output

