def locate_checkpoint(dataset_name, model_name):

    model_directory = (
        CHECKPOINT_DIR / dataset_name
    )

    candidates = [
        model_directory / f"{model_name}_best.pth",
        model_directory / f"best_{model_name}.pth",
        model_directory / f"{model_name}.pth",
    ]

    for path in candidates:

        if path.exists():
            return path

    # Search for alternative model-specific checkpoint names.
    matches = list(
        model_directory.glob(
            f"*{model_name}*.pth"
        )
    )

    if len(matches) == 1:
        return matches[0]

    if len(matches) > 1:

        best_matches = [
            path for path in matches
            if "best" in path.stem.lower()
        ]

        if len(best_matches) == 1:
            return best_matches[0]

    raise FileNotFoundError(
        f"\nCheckpoint not found for {dataset_name}: "
        f"{model_name}\n"
        f"Expected directory: {model_directory}\n"
        "Check the checkpoint filenames saved in Block 11."
    )


