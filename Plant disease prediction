                    # IMAGE SUCCESS COUNTER
                    # ----------------------------------------

                    processed_images += 1

                    successfully_explained_paths.add(
                        str(image_path)
                    )

                    # ----------------------------------------
                    # PROGRESS REPORT
                    # ----------------------------------------

                    if (
                        processed_images % 10 == 0
                        or image_index == len(test_df) - 1
                    ):

                        print(
                            f"Progress: {processed_images}/"
                            f"{len(test_df)} images | "
                            f"Failed: {failed_images}"
                        )

                except Exception as image_error:

                    failed_images += 1

                    warnings.warn(
                        f"Image failed: {image_path} | "
                        f"{str(image_error)}"
                    )

                    error_records.append({

                        "dataset": dataset_name,

                        "model": model_label,

                        "reason": str(image_error),

                        "image_path": str(image_path)

                    })

                    continue

            # ------------------------------------------------
            # 11.9 MODEL EXPERIMENT SUMMARY
            # ------------------------------------------------

            unique_explained_images = len(
                successfully_explained_paths
            )

            total_stability_records = len(
                model_records
            )

            print("\nMODEL EXPERIMENT SUMMARY")
            print("-" * 60)

            print(
                f"Successfully explained images: "
                f"{unique_explained_images}"
            )

            print(
                f"Failed images: {failed_images}"
            )

            print(
                f"Stability comparison records: "
                f"{total_stability_records}"
            )

            print(
                f"Prediction records generated: "
                f"{len(prediction_records)}"
            )

            # ------------------------------------------------
            # 11.10 CLEANUP
            # ------------------------------------------------

        except Exception as model_error:

            print(
                f"\nFAILED MODEL: {model_label}"
            )

            print(
                f"Reason: {str(model_error)}"
            )

            error_records.append({

                "dataset": dataset_name,

                "model": model_label,

                "reason": str(model_error)

            })

        finally:

            if model is not None:

                del model

            gc.collect()

            if torch.cuda.is_available():

                torch.cuda.empty_cache()

