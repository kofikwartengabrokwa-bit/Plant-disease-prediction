def predict_image(model, image_tensor):

    model.eval()

    with torch.no_grad():

        output = model(
            image_tensor.unsqueeze(0).to(DEVICE)
        )

        probabilities = torch.softmax(
            output,
            dim=1
        )

        predicted_class = int(
            probabilities.argmax(dim=1).item()
        )

        confidence = float(
            probabilities[0, predicted_class].item()
        )

    return predicted_class, confidence


# ------------------------------------------------------------
# 7. OCCLUSION EXPLANATION MAP
# ------------------------------------------------------------
# Each grid region is replaced with normalized zero.
# Because the input uses ImageNet normalization, zero
# approximately corresponds to the ImageNet mean color.
#
# Importance(region) =
# baseline confidence - occluded confidence.
#
# Positive values indicate that occluding the region
# reduced confidence in the selected target class.
#
# Negative values indicate that occluding the region
# increased confidence.

def generate_occlusion_map(
    model,
    image_tensor,
    target_class
):

    model.eval()

    _, channels, height, width = (
        image_tensor.unsqueeze(0).shape
    )

    patch_height = height // GRID_ROWS
    patch_width = width // GRID_COLS

    with torch.no_grad():

        baseline_output = model(
            image_tensor.unsqueeze(0).to(DEVICE)
        )

        baseline_probability = torch.softmax(
            baseline_output,
            dim=1
        )[0, target_class].item()

    masked_images = []
    region_positions = []

    for row in range(GRID_ROWS):

        for col in range(GRID_COLS):

            y1 = row * patch_height
            y2 = (
                height
                if row == GRID_ROWS - 1
                else (row + 1) * patch_height
            )

            x1 = col * patch_width
            x2 = (
                width
                if col == GRID_COLS - 1
                else (col + 1) * patch_width
            )

            masked = image_tensor.clone()

            masked[:, y1:y2, x1:x2] = 0.0

            masked_images.append(masked)
            region_positions.append((row, col))

    region_importance = np.zeros(
        (GRID_ROWS, GRID_COLS),
        dtype=np.float32
    )

    for start in range(
        0,
        len(masked_images),
        OCCLUSION_BATCH_SIZE
    ):

        batch_images = torch.stack(
            masked_images[
                start:start + OCCLUSION_BATCH_SIZE
            ]
        ).to(DEVICE)

        with torch.no_grad():

            outputs = model(batch_images)

            probabilities = torch.softmax(
                outputs,
                dim=1
            )

            target_probabilities = probabilities[
                :, target_class
            ].cpu().numpy()

        for local_index, probability in enumerate(
            target_probabilities
        ):

            global_index = (
                start + local_index
            )

            row, col = region_positions[
                global_index
            ]

            region_importance[row, col] = (
                baseline_probability - probability
            )

    return region_importance


# ------------------------------------------------------------
# 8. MAP COMPARISON METRICS
# ------------------------------------------------------------

def flatten_map(explanation_map):

    return np.asarray(
        explanation_map,
        dtype=np.float64
    ).flatten()


def calculate_pearson(map_a, map_b):

    a = flatten_map(map_a)
    b = flatten_map(map_b)

    if (
        np.std(a) < 1e-12
        or np.std(b) < 1e-12
    ):
        return np.nan

    return float(
        np.corrcoef(a, b)[0, 1]
    )


def calculate_spearman(map_a, map_b):

    a = flatten_map(map_a)
    b = flatten_map(map_b)

    if (
        np.std(a) < 1e-12
        or np.std(b) < 1e-12
    ):
        return np.nan

    result = spearmanr(a, b)

    return float(result.statistic)


def calculate_cosine_similarity(map_a, map_b):

    a = flatten_map(map_a)
    b = flatten_map(map_b)

    denominator = (
        np.linalg.norm(a)
        * np.linalg.norm(b)
    )

    if denominator < 1e-12:
        return np.nan

    return float(
        np.dot(a, b) / denominator
    )


def calculate_top_k_overlap(
    map_a,
    map_b,
    k=TOP_K_REGIONS
):

    a = flatten_map(map_a)
    b = flatten_map(map_b)

    k = min(k, len(a))

    top_a = set(
        np.argsort(a)[-k:]
    )

    top_b = set(
        np.argsort(b)[-k:]
    )

    intersection = len(
        top_a.intersection(top_b)
    )

    union = len(
        top_a.union(top_b)
    )

    return (
        intersection / union
        if union > 0
        else np.nan
    )


def compare_explanation_maps(
    reference_map,
    comparison_map,
    transformation
):

    aligned_map = comparison_map.copy()

    # Horizontal flip changes spatial orientation.
    # Reverse columns to restore original coordinates.
    if transformation == "horizontal_flip":

        aligned_map = np.fliplr(
            aligned_map
        )

    return {
        "pearson_correlation": calculate_pearson(
            reference_map,
            aligned_map
        ),

        "spearman_correlation": calculate_spearman(
            reference_map,
            aligned_map
        ),

        "cosine_similarity": calculate_cosine_similarity(
            reference_map,
            aligned_map
        ),

        "top_k_overlap": calculate_top_k_overlap(
            reference_map,
            aligned_map
        )
    }


