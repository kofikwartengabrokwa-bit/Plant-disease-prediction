        )

        for folder in class_directories

    }

    nonzero_counts = [

        count

        for count in class_counts.values()

        if count > 0

    ]

    if nonzero_counts:

        imbalance_ratio = (
            max(nonzero_counts) / min(nonzero_counts)
        )

        class_mean = np.mean(nonzero_counts)

        class_std = np.std(nonzero_counts)

        class_cv = (
            class_std / class_mean
            if class_mean > 0
            else 0
        )

    else:

        imbalance_ratio = np.nan

        class_cv = np.nan

