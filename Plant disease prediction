        ],
        as_index=False
    )
    .agg(
        prediction_consistency_rate=(
            "prediction_consistent",
            "mean"
        ),
        mean_confidence=(
            "transformed_confidence",
            "mean"
        ),
        mean_original_confidence=(
            "original_confidence",
            "mean"
        ),
        number_of_images=(
            "image_path",
            "count"
        )
    )
)

