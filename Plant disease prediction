def apply_holm_correction(
    dataframe,
    p_column,
    group_columns
):

    dataframe = dataframe.copy()

    dataframe["adjusted_p_value"] = np.nan

    dataframe["significant_0_05"] = False

    for _, indices in dataframe.groupby(
        group_columns
    ).groups.items():

        valid_indices = [
            index
            for index in indices
            if pd.notna(
                dataframe.loc[index, p_column]
            )
        ]

        if not valid_indices:
            continue

        adjusted = multipletests(
            dataframe.loc[
                valid_indices,
                p_column
            ].values,
            method="holm"
        )

        dataframe.loc[
            valid_indices,
            "adjusted_p_value"
        ] = adjusted[1]

        dataframe.loc[
            valid_indices,
            "significant_0_05"
        ] = adjusted[0]

    return dataframe


