def calculate_effect_size(
    proposed_score,
    baseline_score
):

    difference = (
        proposed_score - baseline_score
    )

    if abs(baseline_score) < 1e-12:

        relative_improvement = np.nan

    else:

        relative_improvement = (
            difference / abs(baseline_score)
        ) * 100

    return (
        difference,
        relative_improvement
    )


