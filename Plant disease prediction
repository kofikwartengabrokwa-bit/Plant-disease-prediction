def plot_confusion_matrix(
    y_true,
    y_pred,
    class_names,
    dataset_name,
    model_name
):

    cm = confusion_matrix(
        y_true,
        y_pred,
        labels=np.arange(len(class_names))
    )

    cm_normalized = (
        cm.astype(float)
        / np.maximum(
            cm.sum(axis=1, keepdims=True),
            1
        )
    )

    fig, ax = plt.subplots(
        figsize=(10, 8)
    )

    image = ax.imshow(
        cm_normalized,
        interpolation="nearest",
        cmap="Blues",
        vmin=0,
        vmax=1
    )

    fig.colorbar(
        image,
        ax=ax,
        fraction=0.046,
        pad=0.04
    )

    ax.set_xticks(
        np.arange(len(class_names))
    )

    ax.set_yticks(
        np.arange(len(class_names))
    )

    ax.set_xticklabels(
        class_names,
        rotation=45,
        ha="right"
    )

    ax.set_yticklabels(
        class_names
    )

    ax.set_xlabel("Predicted Class")

    ax.set_ylabel("Actual Class")

    ax.set_title(
        f"{MODEL_LABELS[model_name]} - "
        f"{dataset_name.title()}\nNormalized Confusion Matrix"
    )

    for i in range(len(class_names)):

        for j in range(len(class_names)):

            ax.text(
                j,
                i,
                f"{cm[i, j]}\n"
                f"({cm_normalized[i, j]:.2f})",
                ha="center",
                va="center",
                fontsize=7,
                color=(
                    "white"
                    if cm_normalized[i, j] > 0.5
                    else "black"
                )
            )

    plt.tight_layout()

    output_path = (
        FIGURE_DIR
        / f"{dataset_name}_{model_name}_confusion_matrix.png"
    )

    plt.savefig(
        output_path,
        dpi=600,
        bbox_inches="tight"
    )

    plt.close(fig)


