def unwrap_logits(output):

    """
    Handles models that return structured outputs,
    such as InceptionV3 during training.
    """

    if hasattr(output, "logits"):

        return output.logits

    return output


class FourModelEnsemble(nn.Module):

    """
    Four-model ensemble:

       VGG16
       VGG19
       ResNet101V2
       InceptionV3

    Aggregation:
       Mean of the four class probability vectors.

    Final output:
       Log probabilities for CrossEntropyLoss.
    """

    def __init__(
        self,
        num_classes,
        pretrained=False
    ):

        super().__init__()

        # ----------------------------------------------------
        # VGG16
        # ----------------------------------------------------

        self.vgg16 = models.vgg16(

            weights=(
                models.VGG16_Weights.DEFAULT
                if pretrained
                else None
            )

        )

        self.vgg16.classifier[-1] = nn.Linear(

            self.vgg16.classifier[-1].in_features,

            num_classes

        )

        # ----------------------------------------------------
        # VGG19
        # ----------------------------------------------------

        self.vgg19 = models.vgg19(

            weights=(
                models.VGG19_Weights.DEFAULT
                if pretrained
                else None
            )

        )

        self.vgg19.classifier[-1] = nn.Linear(

            self.vgg19.classifier[-1].in_features,

            num_classes

        )

        # ----------------------------------------------------
        # RESNET101V2
        # ----------------------------------------------------

        self.resnet101v2 = timm.create_model(

            "resnetv2_101",

            pretrained=pretrained,

            num_classes=num_classes

        )

        # ----------------------------------------------------
        # INCEPTIONV3
        # ----------------------------------------------------

        self.inception = models.inception_v3(

            weights=(
                models.Inception_V3_Weights.DEFAULT
                if pretrained
                else None
            ),

            aux_logits=pretrained

        )

        self.inception.fc = nn.Linear(

            self.inception.fc.in_features,

            num_classes

        )

        # Replace auxiliary classifier when present

        if self.inception.AuxLogits is not None:

            self.inception.AuxLogits.fc = nn.Linear(

                self.inception.AuxLogits.fc.in_features,

                num_classes

            )

    def forward(self, x):

        # Obtain individual model outputs

        output_vgg16 = unwrap_logits(
            self.vgg16(x)
        )

        output_vgg19 = unwrap_logits(
            self.vgg19(x)
        )

        output_resnet = unwrap_logits(
            self.resnet101v2(x)
        )

        output_inception = unwrap_logits(
            self.inception(x)
        )

        # Probability aggregation

        probabilities = (

            F.softmax(output_vgg16, dim=1)

            + F.softmax(output_vgg19, dim=1)

            + F.softmax(output_resnet, dim=1)

            + F.softmax(output_inception, dim=1)

        ) / 4.0

        return torch.log(
            probabilities.clamp_min(1e-8)
        )


