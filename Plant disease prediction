# 11. TRAIN ENSEMBLE FOR ONE DATASET
# ------------------------------------------------------------

def train_ensemble(dataset_name):

    print("\n" + "=" * 75)

    print(
        f"TRAINING FOUR-MODEL ENSEMBLE: "
        f"{dataset_name.upper()}"
    )

    print("=" * 75)

    (
        train_df,
        val_df,
        class_names,
        class_to_index
    ) = load_splits(dataset_name)

    num_classes = len(class_names)

    train_dataset = EnsembleDiseaseDataset(
        train_df,
        class_to_index,
        train_transform
    )

    val_dataset = EnsembleDiseaseDataset(
        val_df,
        class_to_index,
        validation_transform
    )

    train_loader = DataLoader(
        train_dataset,
        batch_size=BATCH_SIZE,
        shuffle=True,
        num_workers=NUM_WORKERS,
        pin_memory=(DEVICE.type == "cuda")
    )

    val_loader = DataLoader(
        val_dataset,
        batch_size=BATCH_SIZE,
        shuffle=False,
        num_workers=NUM_WORKERS,
        pin_memory=(DEVICE.type == "cuda")
    )

    # Build ensemble.
    model = build_four_model_ensemble(
        num_classes
    )

    total_parameters = sum(
        parameter.numel()
        for parameter in model.parameters()
    )

    trainable_parameters = sum(
        parameter.numel()
        for parameter in model.parameters()
        if parameter.requires_grad
    )

    print("\nEnsemble components:")
    print("1. VGG16")
    print("2. VGG19")
    print("3. ResNet101V2")
    print("4. InceptionV3")

    print("Total parameters:", f"{total_parameters:,}")

    print(
        "Trainable parameters:",
        f"{trainable_parameters:,}"
    )

    criterion = nn.CrossEntropyLoss()

    optimizer = torch.optim.AdamW(
        model.parameters(),
        lr=LEARNING_RATE,
        weight_decay=WEIGHT_DECAY
    )

    scheduler = torch.optim.lr_scheduler.ReduceLROnPlateau(
        optimizer,
        mode="min",
        factor=0.5,
        patience=3
    )

    best_accuracy = -1.0

    best_loss = float("inf")

    best_epoch = 0

    patience_counter = 0

    history = []

    output_dir = CHECKPOINT_DIR / dataset_name

    output_dir.mkdir(
        parents=True,
        exist_ok=True
    )

    checkpoint_path = (
        output_dir
        / "Four_Model_Ensemble_LIME_best.pth"
    )

    start_time = time.time()

    # --------------------------------------------------------
    # EPOCH LOOP
    # --------------------------------------------------------

    for epoch in range(1, NUM_EPOCHS + 1):

        epoch_start = time.time()

        train_loss, train_accuracy = run_epoch(
            model,
            train_loader,
            criterion,
            optimizer
        )

        val_loss, val_accuracy = run_epoch(
