def load_splits(dataset_name):

    manifest_path = (
        PROJECT_DIR
        / "data"
        / "splits"
        / dataset_name
        / "split_manifest.csv"
    )

    dataframe = pd.read_csv(manifest_path)

    dataframe["class_name"] = (
        dataframe["class_name"].astype(str)
    )

    dataframe["split"] = (
        dataframe["split"].astype(str).str.lower()
    )

    class_names = sorted(
        dataframe["class_name"].unique().tolist()
    )

    class_to_index = {
        name: index
        for index, name in enumerate(class_names)
    }

    train_df = dataframe[
        dataframe["split"] == "train"
    ].copy()

    val_df = dataframe[
        dataframe["split"].isin(["validation", "val"])
    ].copy()

    test_count = int(
        (dataframe["split"] == "test").sum()
    )

    if train_df.empty or val_df.empty:

        raise ValueError(
            f"{dataset_name}: empty training or validation split."
        )

    if set(train_df["class_name"]) != set(class_names):

        raise ValueError(
            f"{dataset_name}: training split is missing classes."
        )

    if set(val_df["class_name"]) != set(class_names):

        raise ValueError(
            f"{dataset_name}: validation split is missing classes."
        )

    missing_paths = [
        path for path in dataframe["image_path"]
        if not Path(path).exists()
    ]

    if missing_paths:

        raise FileNotFoundError(
            f"Missing image: {missing_paths[0]}"
        )

    print(f"\n{dataset_name.upper()} DATASET")
    print("Number of classes:", len(class_names))
    print("Training images:", len(train_df))
    print("Validation images:", len(val_df))
    print("Reserved test images:", test_count)

    return (
        train_df,
        val_df,
        class_names,
        class_to_index
    )


# ------------------------------------------------------------
# 8. BUILD EFFICIENTNETB5
# ------------------------------------------------------------

def build_efficientnet_b5(num_classes):

    if USE_PRETRAINED:

        weights = EfficientNet_B5_Weights.DEFAULT

    else:

        weights = None

    model = efficientnet_b5(weights=weights)

    input_features = model.classifier[1].in_features

    model.classifier[1] = nn.Linear(
        input_features,
        num_classes
    )

    return model


# ------------------------------------------------------------
# 9. TRAINING / VALIDATION FUNCTION
# ------------------------------------------------------------

def run_epoch(
    model,
    loader,
    criterion,
    optimizer=None
):

    training = optimizer is not None

    if training:
        model.train()
    else:
        model.eval()

    total_loss = 0.0
    total_correct = 0
    total_samples = 0

    for images, labels in loader:

        images = images.to(DEVICE)
        labels = labels.to(DEVICE)

        if training:

            optimizer.zero_grad(set_to_none=True)

        with torch.set_grad_enabled(training):

            outputs = model(images)

            loss = criterion(outputs, labels)

            if training:

                loss.backward()

                optimizer.step()

        batch_size = labels.size(0)

        total_loss += loss.item() * batch_size

        predictions = outputs.argmax(dim=1)

        total_correct += (
            predictions == labels
        ).sum().item()

        total_samples += batch_size

    average_loss = total_loss / max(total_samples, 1)

    accuracy = (
        total_correct / max(total_samples, 1)
    ) * 100

    return average_loss, accuracy


