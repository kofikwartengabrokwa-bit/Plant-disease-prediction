# 11. EVALUATE ONE MODEL
# ============================================================

def evaluate_model(
    dataset,
    model_name,
    model_config,
    test_df
):

    print("\n" + "-" * 75)
    print("Dataset:", dataset)
    print("Model:", model_name)
    print("-" * 75)

    model, checkpoint, class_names, checkpoint_path = (
        load_model(
            dataset,
            model_name
        )
    )

    image_size = int(
        checkpoint.get(
            "image_size",
            model_config["image_size"]
        )
    )

    class_to_index = {
        name: index
        for index, name in enumerate(class_names)
    }

    # Ensure all test classes are represented by the checkpoint.
    unknown_classes = (
        set(test_df["class_name"].astype(str))
        -
        set(class_names)
    )

    if unknown_classes:

        raise ValueError(
            f"Test classes not present in checkpoint: "
            f"{unknown_classes}"
        )

    all_probabilities = []
    all_predictions = []
    all_actual = []
    all_confidence = []
    all_entropy = []
    all_normalized_entropy = []
    all_margins = []

    prediction_records = []

    start_time = time.perf_counter()

    # --------------------------------------------------------
    # 11A. INFERENCE ON ALL TEST IMAGES
    # --------------------------------------------------------

    for _, row in test_df.iterrows():

        image_path = row["image_path"]

        image_tensor = load_image(
            image_path,
            image_size
        )

        probabilities = predict_batch(
            model,
            image_tensor.unsqueeze(0)
        )[0]

        predicted_index = int(
            np.argmax(probabilities)
        )

        actual_index = class_to_index[
            str(row["class_name"])
        ]

        uncertainty = calculate_uncertainty_metrics(
            probabilities.reshape(1, -1)
        )

        confidence = float(
            uncertainty["confidence"][0]
        )

        entropy = float(
            uncertainty["entropy"][0]
        )

        normalized_entropy = float(
            uncertainty["normalized_entropy"][0]
        )

        margin = float(
            uncertainty["confidence_margin"][0]
        )

        all_probabilities.append(
            probabilities
        )

        all_predictions.append(
            predicted_index
        )

        all_actual.append(
            actual_index
        )

        all_confidence.append(
            confidence
        )

        all_entropy.append(
            entropy
        )

        all_normalized_entropy.append(
            normalized_entropy
        )

        all_margins.append(
            margin
        )

        record = {
            "dataset": dataset,
            "model": model_name,
            "image_path": str(image_path),
            "actual_class": class_names[actual_index],
            "predicted_class": class_names[predicted_index],
            "correct": int(
                predicted_index == actual_index
            ),
            "confidence": confidence,
            "entropy": entropy,
            "normalized_entropy": normalized_entropy,
            "confidence_margin": margin
        }

        for class_index, class_name in enumerate(
            class_names
        ):

            record[
                f"probability_{class_name}"
            ] = float(
                probabilities[class_index]
            )

        prediction_records.append(
            record
        )

    inference_time = (
        time.perf_counter() - start_time
    )

    probabilities_array = np.asarray(
        all_probabilities
    )

    actual_array = np.asarray(
        all_actual
    )

    predicted_array = np.asarray(
        all_predictions
    )

    # --------------------------------------------------------
    # 11B. CLASSIFICATION AND UNCERTAINTY METRICS
    # --------------------------------------------------------

    accuracy = accuracy_score(
        actual_array,
        predicted_array
    )

    macro_f1 = f1_score(
        actual_array,
        predicted_array,
        average="macro",
        zero_division=0
    )

    metrics = {
        "dataset": dataset,
        "model": model_name,
        "model_label": model_config["label"],
        "test_images": len(test_df),
        "accuracy": accuracy,
        "macro_f1": macro_f1,
        "mean_confidence": np.mean(all_confidence),
        "median_confidence": np.median(all_confidence),
        "mean_entropy": np.mean(all_entropy),
        "mean_normalized_entropy": np.mean(
            all_normalized_entropy
        ),
        "mean_confidence_margin": np.mean(
            all_margins
        ),
        "inference_time_seconds": inference_time,
        "mean_inference_time_ms": (
            inference_time /
            len(test_df) *
            1000
        )
    }

    # --------------------------------------------------------
    # 11C. EXPLANATION COMPREHENSIVENESS
    # --------------------------------------------------------

    comp_subset = select_comprehensiveness_subset(
        test_df,
        MAX_COMPREHENSIVENESS_IMAGES
    )

    comp_records = []

    for sample_number, (_, row) in enumerate(
        comp_subset.iterrows(),
        start=1
    ):

        image_tensor = load_image(
            row["image_path"],
            image_size
        )

        original_probabilities = predict_batch(
            model,
            image_tensor.unsqueeze(0)
        )[0]

        comp_result = calculate_comprehensiveness(
            model=model,
            image_tensor=image_tensor,
            original_probabilities=original_probabilities,
            grid_size=OCCLUSION_GRID,
            top_fraction=TOP_REGION_FRACTION
        )

        comp_records.append({
            "dataset": dataset,
            "model": model_name,
            "image_path": str(row["image_path"]),
            "actual_class": str(row["class_name"]),
            "predicted_class": class_names[
                int(np.argmax(original_probabilities))
            ],
            **comp_result
        })

        if sample_number % 25 == 0:

            print(
                f"Comprehensiveness: "
                f"{sample_number}/{len(comp_subset)}"
            )

    comp_df = pd.DataFrame(
        comp_records
    )

    metrics["comprehensiveness_images"] = len(
        comp_df
    )

    metrics["mean_comprehensiveness"] = (
        comp_df["comprehensiveness"].mean()
    )

    metrics["median_comprehensiveness"] = (
        comp_df["comprehensiveness"].median()
    )

    metrics["mean_confidence_after_removal"] = (
        comp_df["confidence_after_removal"].mean()
    )

    metrics["positive_comprehensiveness_ratio"] = (
        comp_df["comprehensiveness"].gt(0).mean()
    )

    # --------------------------------------------------------
    # 11D. SAVE MODEL-LEVEL RESULTS
    # --------------------------------------------------------

    prediction_df = pd.DataFrame(
        prediction_records
    )

    prediction_dir = (
        OUTPUT_DIR /
        "predictions"
    )

    comprehensiveness_dir = (
        OUTPUT_DIR /
        "comprehensiveness"
    )

    prediction_dir.mkdir(
        parents=True,
        exist_ok=True
    )

    comprehensiveness_dir.mkdir(
        parents=True,
        exist_ok=True
    )

    prediction_df.to_csv(
        prediction_dir /
        f"{dataset}_{model_name}_predictions.csv",
        index=False
    )

    comp_df.to_csv(
        comprehensiveness_dir /
        f"{dataset}_{model_name}_comprehensiveness.csv",
        index=False
    )

    print(
        f"Accuracy: {accuracy:.4f}"
    )

    print(
        f"Mean confidence: {metrics['mean_confidence']:.4f}"
    )

    print(
        f"Normalized entropy: "
        f"{metrics['mean_normalized_entropy']:.4f}"
    )

    print(
        f"Comprehensiveness: "
        f"{metrics['mean_comprehensiveness']:.4f}"
    )

    del model

    if torch.cuda.is_available():
        torch.cuda.empty_cache()

    return metrics, prediction_df, comp_df

