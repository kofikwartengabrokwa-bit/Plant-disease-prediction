    )

    test_df = load_test_images(dataset_name)

    predict_function = create_ensemble_predict_function(
        model
    )

    explainer = LimeImageExplainer(
        random_state=RANDOM_SEED
    )

    sample_count = min(
        NUM_EXPLANATIONS_PER_DATASET,
        len(test_df)
    )

    # Reproducible selection from test data.
    rng = np.random.default_rng(
        RANDOM_SEED
    )

    selected_indices = rng.choice(
        len(test_df),
        size=sample_count,
        replace=False
    )

    selected_df = test_df.iloc[
        selected_indices
    ].reset_index(drop=True)

    records = []

    output_dir = (
        EXPLANATION_DIR / dataset_name
    )

    for index, row in selected_df.iterrows():

        image_path = Path(
            row["image_path"]
        )

        true_class = str(
            row["class_name"]
        )

        original_image = Image.open(
            image_path
        ).convert("RGB")

        original_image = original_image.resize(
            (IMAGE_SIZE, IMAGE_SIZE)
        )

        image_array = np.asarray(
            original_image
        )

        print(
            f"\nImage {index + 1}/{sample_count}: "
            f"{image_path.name}"
        )

        # ----------------------------------------------------
        # ORIGINAL PREDICTION
        # ----------------------------------------------------

        probabilities = predict_function(
            np.expand_dims(
                image_array,
                axis=0
            )
        )[0]

        predicted_index = int(
            np.argmax(probabilities)
        )

        predicted_class = class_names[
            predicted_index
        ]

        confidence = float(
            probabilities[predicted_index]
        )

        true_index = class_names.index(
            true_class
        )

        true_probability = float(
            probabilities[true_index]
        )

        # ----------------------------------------------------
        # LIME EXPLANATION
        # ----------------------------------------------------

        start_time = time.time()

        explanation = explainer.explain_instance(

            image=image_array,

            classifier_fn=predict_function,

            top_labels=1,

            hide_color=0,

            num_samples=NUM_SAMPLES

        )

        explanation_time = (
            time.time() - start_time
        )

        # Full positive and negative evidence.
        temp, mask = explanation.get_image_and_mask(

            label=predicted_index,

            positive_only=False,

            num_features=NUM_FEATURES,

            hide_rest=False

        )

        # Positive evidence only.
        positive_temp, positive_mask = (
            explanation.get_image_and_mask(

                label=predicted_index,

                positive_only=True,

                num_features=NUM_FEATURES,

                hide_rest=False

            )
        )

        # ----------------------------------------------------
        # VISUALIZATION
        # ----------------------------------------------------

        fig, axes = plt.subplots(
            1,
            3,
            figsize=(17, 5)
        )

        axes[0].imshow(image_array)

        axes[0].set_title(
            f"Original Image\nTrue: {true_class}"
        )

        axes[1].imshow(
            mark_boundaries(
                temp / 255.0,
                mask
            )
        )

        axes[1].set_title(
            f"Ensemble LIME\nPredicted: {predicted_class}"
        )

        axes[2].imshow(
            mark_boundaries(
                positive_temp / 255.0,
                positive_mask
            )
        )

        axes[2].set_title(
            "Positive Supporting Regions"
        )

        for axis in axes:

            axis.axis("off")

        plt.tight_layout()

        figure_path = (
            output_dir
            / f"Ensemble_LIME_{index + 1:02d}.png"
        )

        plt.savefig(
            figure_path,
            dpi=600,
            bbox_inches="tight"
        )

        plt.close(fig)

        # ----------------------------------------------------
        # RECORD RESULTS
        # ----------------------------------------------------

        correct = (
            predicted_class == true_class
        )

        records.append({

            "dataset": dataset_name,

            "image": image_path.name,

