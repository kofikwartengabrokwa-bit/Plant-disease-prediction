            )

            ax.tick_params(
                axis="x",
                rotation=25
            )

            ax.grid(
                axis="y",
                linestyle="--",
                alpha=0.4
            )

            for bar in bars:

                height = bar.get_height()

                if np.isfinite(height):

                    ax.text(
                        bar.get_x() + bar.get_width() / 2,
                        height,
                        f"{height:.3f}",
