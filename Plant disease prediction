# 9. LOAD TEST MANIFEST
# ============================================================

def load_test_manifest(dataset):

    manifest_path = (
        PROJECT_DIR /
        "data" /
        "splits" /
        dataset /
        "split_manifest.csv"
    )

    if not manifest_path.exists():

        raise FileNotFoundError(
            f"Test manifest not found: {manifest_path}"
        )

    manifest = pd.read_csv(
        manifest_path
    )

    required_columns = [
        "image_path",
        "class_name",
        "split"
    ]

    missing = [
        col for col in required_columns
        if col not in manifest.columns
    ]

    if missing:

        raise KeyError(
            f"Missing manifest columns: {missing}"
        )

    test_df = manifest[
        manifest["split"].astype(str).str.lower() == "test"
    ].copy()

    test_df.reset_index(
        drop=True,
        inplace=True
    )

    if test_df.empty:

        raise ValueError(
            f"No test images found for {dataset}"
        )

    return test_df

# ============================================================
# 10. STRATIFIED SUBSET FOR COMPREHENSIVENESS
# ============================================================

def select_comprehensiveness_subset(
    test_df,
    max_images
):

    if len(test_df) <= max_images:

        return test_df.copy()

    selected = (
        test_df.groupby(
            "class_name",
            group_keys=False
        )
        .apply(
            lambda group: group.sample(
                n=min(
                    len(group),
                    max(
                        1,
                        int(
                            max_images *
                            len(group) /
                            len(test_df)
                        )
                    )
                ),
                random_state=SEED
            )
        )
    )

    if len(selected) > max_images:

        selected = selected.sample(
            n=max_images,
            random_state=SEED
        )

    return selected.reset_index(
        drop=True
    )

