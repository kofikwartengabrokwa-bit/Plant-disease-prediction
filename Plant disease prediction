# 5. STRATIFIED PAIRED BOOTSTRAP
# ============================================================

def stratified_bootstrap_indices(
    y_true,
    classes,
    random_generator
):

    selected = []

    for class_name in classes:

        class_indices = np.where(
            y_true == class_name
        )[0]

        if len(class_indices) == 0:
            continue

        sampled = random_generator.choice(
            class_indices,
            size=len(class_indices),
            replace=True
        )

        selected.extend(sampled)

    return np.asarray(selected, dtype=int)


def paired_bootstrap_comparison(
    y_true,
    proposed_pred,
    baseline_pred,
    classes,
    dataset_name,
    baseline_name
):

    metric_names = [
        "accuracy",
        "macro_precision",
        "macro_recall",
        "macro_f1"
    ]

    proposed_metrics = get_metric_values(
        y_true,
        proposed_pred,
        classes
    )

    baseline_metrics = get_metric_values(
        y_true,
        baseline_pred,
        classes
    )

    proposed_specificity = get_specificity(
        y_true,
        proposed_pred,
        classes
    )

    baseline_specificity = get_specificity(
        y_true,
        baseline_pred,
        classes
    )

    proposed_metrics[
        "macro_specificity"
    ] = proposed_specificity

    baseline_metrics[
        "macro_specificity"
    ] = baseline_specificity

    bootstrap_differences = {
        metric: []
        for metric in metric_names + [
            "macro_specificity"
        ]
    }

    for iteration in range(
        BOOTSTRAP_ITERATIONS
    ):

        indices = stratified_bootstrap_indices(
            y_true,
            classes,
            rng
        )

        yt = y_true[indices]

        yp = proposed_pred[indices]

        yb = baseline_pred[indices]

        proposed_result = get_metric_values(
            yt,
            yp,
            classes
        )

        baseline_result = get_metric_values(
            yt,
            yb,
            classes
        )

        proposed_result[
            "macro_specificity"
        ] = get_specificity(
            yt,
            yp,
            classes
        )

        baseline_result[
            "macro_specificity"
        ] = get_specificity(
            yt,
            yb,
            classes
        )

        for metric in bootstrap_differences:

            difference = (
                proposed_result[metric]
                - baseline_result[metric]
            )

            if np.isfinite(difference):

                bootstrap_differences[
                    metric
                ].append(difference)

    records = []

    alpha = 1 - CONFIDENCE_LEVEL

    for metric in bootstrap_differences:

        differences = np.asarray(
            bootstrap_differences[metric]
        )

        if len(differences) < MIN_VALID_BOOTSTRAPS:

            raise RuntimeError(
                f"Insufficient valid bootstrap samples "
                f"for {metric}: {len(differences)}"
            )

        lower = np.percentile(
            differences,
            100 * alpha / 2
        )

        upper = np.percentile(
            differences,
            100 * (1 - alpha / 2)
        )

        delta = (
            proposed_metrics[metric]
            - baseline_metrics[metric]
        )

        # Two-sided bootstrap sign probability.
        p_positive = (
            np.sum(differences <= 0) + 1
        ) / (
            len(differences) + 1
        )

        p_negative = (
            np.sum(differences >= 0) + 1
        ) / (
            len(differences) + 1
        )

        bootstrap_p = min(
            1.0,
            2 * min(
                p_positive,
                p_negative
            )
        )

        records.append({

            "dataset": dataset_name,

            "proposed_model": PROPOSED_MODEL,

            "baseline_model": baseline_name,

            "metric": metric,

            "proposed_score": proposed_metrics[metric],

            "baseline_score": baseline_metrics[metric],

            "difference": delta,

            "ci_lower_95": lower,

            "ci_upper_95": upper,

            "bootstrap_p_value": bootstrap_p,

            "bootstrap_samples": len(differences),

            "confidence_level": CONFIDENCE_LEVEL

        })

    return records


# ============================================================
# 6. EXACT MCNEMAR TEST
# ============================================================

def calculate_mcnemar(
    y_true,
    proposed_pred,
    baseline_pred,
    dataset_name,
    baseline_name
):

    proposed_correct = (
        proposed_pred == y_true
    )

    baseline_correct = (
        baseline_pred == y_true
    )

    # b: Proposed correct, baseline incorrect.
    b = int(
        np.sum(
            proposed_correct
            & ~baseline_correct
        )
    )

    # c: Proposed incorrect, baseline correct.
    c = int(
        np.sum(
            ~proposed_correct
            & baseline_correct
        )
    )

    discordant = b + c

    if discordant == 0:

        p_value = 1.0

    else:

        p_value = binomtest(
            b,
            n=discordant,
            p=0.5,
            alternative="two-sided"
        ).pvalue

    return {

        "dataset": dataset_name,

        "proposed_model": PROPOSED_MODEL,

        "baseline_model": baseline_name,

        "proposed_only_correct": b,

        "baseline_only_correct": c,

        "discordant_pairs": discordant,

        "mcnemar_exact_p_value": p_value

    }


