def apply_gaussian_noise(
    image,
    severity,
    rng
):

    image_array = np.asarray(
        image,
        dtype=np.float32
    )

    std = CORRUPTION_PARAMETERS[
        "gaussian_noise"
    ][severity]["std"]

    noise = rng.normal(
        loc=0,
        scale=std,
        size=image_array.shape
    )

    noisy_image = np.clip(
        image_array + noise,
        0,
        255
    ).astype(np.uint8)

    return Image.fromarray(
        noisy_image
    )


def apply_gaussian_blur(
    image,
    severity
):

    radius = CORRUPTION_PARAMETERS[
        "gaussian_blur"
    ][severity]["radius"]

    return image.filter(
        ImageFilter.GaussianBlur(
            radius=radius
        )
    )


def apply_brightness(
    image,
    severity
):

    factor = CORRUPTION_PARAMETERS[
        "brightness"
    ][severity]["factor"]

    return ImageEnhance.Brightness(
        image
    ).enhance(factor)


def apply_contrast(
    image,
    severity
):

    factor = CORRUPTION_PARAMETERS[
        "contrast"
    ][severity]["factor"]

    return ImageEnhance.Contrast(
        image
    ).enhance(factor)


def apply_jpeg_compression(
    image,
    severity
):

    quality = CORRUPTION_PARAMETERS[
        "jpeg_compression"
    ][severity]["quality"]

    buffer = io.BytesIO()

    image.save(
        buffer,
        format="JPEG",
        quality=quality
    )

    buffer.seek(0)

    compressed = Image.open(
        buffer
    ).convert("RGB")

    return compressed.copy()


def apply_partial_occlusion(
    image,
    severity,
    rng
):

    image = image.copy()

    width, height = image.size

    fraction = CORRUPTION_PARAMETERS[
        "partial_occlusion"
    ][severity]["fraction"]

    patch_area = (
        width * height * fraction
    )

    patch_side = int(
        math.sqrt(patch_area)
    )

    patch_side = max(
        1,
        min(
            patch_side,
            width,
            height
        )
    )

    x1 = int(
        rng.integers(
            0,
            max(1, width - patch_side + 1)
        )
    )

    y1 = int(
        rng.integers(
            0,
            max(1, height - patch_side + 1)
        )
    )

    x2 = min(
        width,
        x1 + patch_side
    )

    y2 = min(
        height,
        y1 + patch_side
    )

    # Use a neutral grey patch to simulate obstruction.
    patch = Image.new(
        "RGB",
        (x2 - x1, y2 - y1),
        color=(127, 127, 127)
    )

    image.paste(
        patch,
        (x1, y1)
    )

    return image


# ============================================================
# 7. COMBINED CORRUPTION
# ============================================================

def apply_combined_corruption(
    image,
    severity,
    rng
):

    """
    Applies multiple moderate-to-severe disturbances.

    This is a compound stress test, not a separate
    standardized benchmark corruption.
    """

    image = apply_gaussian_noise(
        image,
        severity,
        rng
    )

    image = apply_gaussian_blur(
        image,
        severity
    )

    image = apply_brightness(
        image,
        severity
    )

    image = apply_contrast(
        image,
        severity
    )

    image = apply_jpeg_compression(
        image,
        severity
    )

    image = apply_partial_occlusion(
        image,
        severity,
        rng
    )

    return image


# ============================================================
# 8. GENERAL CORRUPTION INTERFACE
# ============================================================

def corrupt_image(
    image,
    corruption,
    severity,
    image_path
):

    if corruption == "clean":
        return image.copy()

    rng = np.random.default_rng(
        get_image_seed(
            image_path,
            corruption,
            severity
        )
    )

    if corruption == "gaussian_noise":

        return apply_gaussian_noise(
            image,
            severity,
            rng
        )

    elif corruption == "gaussian_blur":

        return apply_gaussian_blur(
            image,
            severity
        )

    elif corruption == "brightness":

        return apply_brightness(
            image,
            severity
        )

    elif corruption == "contrast":

        return apply_contrast(
            image,
            severity
        )

    elif corruption == "jpeg_compression":

        return apply_jpeg_compression(
            image,
            severity
        )

    elif corruption == "partial_occlusion":

        return apply_partial_occlusion(
            image,
            severity,
            rng
        )

    elif corruption == "combined_corruption":

        return apply_combined_corruption(
            image,
            severity,
            rng
        )

    else:

        raise ValueError(
            f"Unknown corruption: {corruption}"
        )


# ============================================================
# 9. LOAD TEST MANIFEST
# ============================================================

def load_test_manifest(dataset):

    manifest_path = (
        PROJECT_DIR /
        "data" /
        "splits" /
        dataset /
        "split_manifest.csv"
    )

    if not manifest_path.exists():

        raise FileNotFoundError(
            f"Manifest not found: {manifest_path}"
        )

    manifest = pd.read_csv(
        manifest_path
    )

    required_columns = [
        "image_path",
        "class_name",
        "split"
    ]

    missing = [
        col for col in required_columns
        if col not in manifest.columns
    ]

    if missing:

        raise KeyError(
            f"Missing columns: {missing}"
        )

    test_df = manifest[
        manifest["split"].astype(str).str.lower()
        == "test"
    ].copy()

    test_df.reset_index(
        drop=True,
        inplace=True
    )

    if MAX_TEST_IMAGES is not None:

        test_df = (
            test_df.groupby(
                "class_name",
                group_keys=False
            )
            .apply(
                lambda group: group.sample(
                    n=min(
                        len(group),
                        max(
                            1,
                            int(
                                MAX_TEST_IMAGES *
                                len(group) /
                                len(test_df)
                            )
                        )
                    ),
                    random_state=SEED
                )
            )
        )

        if len(test_df) > MAX_TEST_IMAGES:

            test_df = test_df.sample(
                n=MAX_TEST_IMAGES,
                random_state=SEED
            )

        test_df = test_df.reset_index(
            drop=True
        )

    if test_df.empty:

        raise ValueError(
            f"No test images available for {dataset}"
        )

    return test_df


# ============================================================
# 10. CHECKPOINT DISCOVERY
# ============================================================

def find_checkpoint(
    dataset,
    model_name
):

    checkpoint_dir = (
        PROJECT_DIR /
        "results" /
        "checkpoints" /
        dataset
    )

    candidates = [

        checkpoint_dir /
        f"{model_name}_best.pth",

        checkpoint_dir /
        f"best_{model_name}.pth",

        checkpoint_dir /
        f"{model_name}.pth"

    ]

    for candidate in candidates:

        if candidate.exists():
            return candidate

    matches = list(
        checkpoint_dir.glob(
            f"*{model_name}*.pth"
        )
    )

    if len(matches) == 1:
        return matches[0]

    raise FileNotFoundError(
        f"Cannot identify checkpoint for "
        f"{dataset}/{model_name}"
    )


# ============================================================
# 11. LOAD MODEL
# ============================================================

def extract_logits(output):

    if isinstance(output, (tuple, list)):

        output = output[0]

    if isinstance(output, dict):

        if "logits" in output:

            output = output["logits"]

        elif "output" in output:

            output = output["output"]

        else:

            raise ValueError(
                "Model output dictionary has no logits."
            )

    if not torch.is_tensor(output):

        raise TypeError(
            "Model must return classification logits."
        )

    return output


def load_model(
    dataset,
    model_name
):

    checkpoint_path = find_checkpoint(
        dataset,
        model_name
    )

    checkpoint = torch.load(
        checkpoint_path,
        map_location=DEVICE,
        weights_only=False
    )

    class_names = list(
        checkpoint["class_names"]
    )

    num_classes = int(
        checkpoint.get(
            "num_classes",
            len(class_names)
        )
    )

    if num_classes != len(class_names):

        raise ValueError(
            "Checkpoint class count does not match class_names."
        )

    # build_model() must be defined in your earlier blocks.
    model = build_model(
        model_name,
        num_classes=num_classes,
        pretrained=False
    )

    model.load_state_dict(
        checkpoint["model_state_dict"]
    )

    model.to(DEVICE)
    model.eval()

    image_size = int(
        checkpoint.get(
            "image_size",
            MODELS[model_name]["image_size"]
        )
    )

    return (
        model,
        class_names,
        image_size
    )


# ============================================================
# 12. IMAGE PATH RESOLUTION
# ============================================================

def resolve_image_path(image_path):

    path = Path(
        str(image_path)
    )

    if path.is_absolute():
        return path

    return PROJECT_DIR / path


# ============================================================
# 13. BATCH PREDICTION
# ============================================================

@torch.inference_mode()
def predict_tensor_batch(
    model,
    images
):

    images = images.to(
        DEVICE,
        non_blocking=True
    )

    logits = extract_logits(
        model(images)
    )

    probabilities = F.softmax(
        logits,
        dim=1
    )

    return probabilities.cpu().numpy()


# ============================================================
# 14. EVALUATE ONE CORRUPTION CONDITION
# ============================================================

def evaluate_condition(
    model,
    test_df,
    class_names,
    image_size,
    corruption,
    severity,
    dataset,
    model_name
):

    class_to_index = {
        name: index
        for index, name in enumerate(class_names)
    }

    missing_classes = (
        set(test_df["class_name"].astype(str))
        -
        set(class_names)
    )

    if missing_classes:

        raise ValueError(
            f"Test classes missing from checkpoint: "
            f"{missing_classes}"
        )

    image_transform = get_transform(
        image_size
    )

    all_predictions = []
    all_probabilities = []
    all_actual = []
    all_records = []

    batch_tensors = []
    batch_labels = []
    batch_paths = []

    def process_batch():

        if not batch_tensors:
            return

        batch = torch.stack(
            batch_tensors
        )

        probabilities = predict_tensor_batch(
            model,
            batch
        )

        predictions = np.argmax(
            probabilities,
            axis=1
        )

        for index in range(len(batch_labels)):

            actual_index = batch_labels[index]
            predicted_index = int(
                predictions[index]
            )

            probability = probabilities[index]

            all_predictions.append(
                predicted_index
            )

            all_probabilities.append(
                probability
            )

            all_actual.append(
                actual_index
            )

            all_records.append({

                "dataset": dataset,
                "model": model_name,
                "corruption": corruption,
                "severity": severity,
                "image_path": batch_paths[index],
                "actual_class": class_names[actual_index],
                "predicted_class": class_names[predicted_index],
                "correct": int(
                    actual_index == predicted_index
                ),
                "confidence": float(
                    np.max(probability)
                )

            })

        batch_tensors.clear()
        batch_labels.clear()
        batch_paths.clear()

    # --------------------------------------------------------
    # Generate identical deterministic corruption conditions
    # for all models, based on the same original images.
    # --------------------------------------------------------

    for _, row in test_df.iterrows():

        image_path = resolve_image_path(
            row["image_path"]
        )

        if not image_path.exists():

            raise FileNotFoundError(
                f"Image not found: {image_path}"
            )

        original_image = Image.open(
            image_path
        ).convert("RGB")

        corrupted = corrupt_image(
            image=original_image,
            corruption=corruption,
            severity=severity,
            image_path=str(row["image_path"])
        )

        image_tensor = image_transform(
            corrupted
        )

        actual_index = class_to_index[
            str(row["class_name"])
        ]

        batch_tensors.append(
            image_tensor
        )

        batch_labels.append(
            actual_index
        )

        batch_paths.append(
            str(row["image_path"])
        )

        if len(batch_tensors) >= BATCH_SIZE:

            process_batch()

    # Process the final incomplete batch.
    process_batch()

    actual_array = np.asarray(
        all_actual
    )

    predicted_array = np.asarray(
        all_predictions
    )

    probabilities_array = np.asarray(
        all_probabilities
    )

    # --------------------------------------------------------
    # Classification metrics.
    # --------------------------------------------------------

    accuracy = accuracy_score(
        actual_array,
        predicted_array
    )

    macro_precision = precision_score(
        actual_array,
        predicted_array,
        average="macro",
        zero_division=0
    )

    macro_recall = recall_score(
        actual_array,
        predicted_array,
        average="macro",
        zero_division=0
    )

    macro_f1 = f1_score(
        actual_array,
        predicted_array,
        average="macro",
        zero_division=0
    )

    balanced_accuracy = balanced_accuracy_score(
        actual_array,
        predicted_array
    )

    mean_confidence = np.mean(
        np.max(
            probabilities_array,
            axis=1
        )
    )

    result = {

        "dataset": dataset,
        "model": model_name,
        "model_label": MODELS[model_name]["label"],
        "corruption": corruption,
        "severity": severity,
        "test_images": len(actual_array),

        "accuracy": accuracy,
        "macro_precision": macro_precision,
        "macro_recall": macro_recall,
        "macro_f1": macro_f1,
        "balanced_accuracy": balanced_accuracy,
        "mean_confidence": mean_confidence

    }

    return result, all_records


