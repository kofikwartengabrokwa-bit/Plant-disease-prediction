        df["class_name"].astype(str)
    )

    test_df = df[
        df["split"] == "test"
    ].copy()

    if test_df.empty:

        raise ValueError(
            f"No test images available for {dataset_name}"
        )

    # Resolve relative paths using the project directory.
    def resolve_image_path(value):

        path = Path(str(value))

        if not path.is_absolute():

            path = PROJECT_DIR / path

        return path

    test_df["image_path"] = (
        test_df["image_path"].apply(
            resolve_image_path
        )
    )

    missing_images = [
        str(path)
        for path in test_df["image_path"]
        if not path.exists()
    ]

    if missing_images:

        raise FileNotFoundError(
            f"{len(missing_images)} test images "
            f"could not be found.\n"
            f"First missing image: {missing_images[0]}"
        )

    return test_df.reset_index(drop=True)


# ============================================================
# 6. TEST DATASET
# ============================================================

class DiseaseTestDataset(Dataset):

    def __init__(
        self,
        dataframe,
        class_names,
        image_size
    ):

        self.dataframe = dataframe.reset_index(
            drop=True
        )

        self.class_names = class_names

        self.class_to_idx = {
            name: index
            for index, name in enumerate(class_names)
        }

        self.image_size = image_size

        self.transform = transforms.Compose([

            transforms.Resize(
                (image_size, image_size)
            ),

            transforms.ToTensor(),

            NORMALIZE

        ])

    def __len__(self):

        return len(self.dataframe)

    def __getitem__(self, index):

        row = self.dataframe.iloc[index]

        image_path = Path(
            row["image_path"]
        )

        image = Image.open(
            image_path
        ).convert("RGB")

        image = self.transform(image)

        class_name = str(
            row["class_name"]
        )

        label = self.class_to_idx[
            class_name
        ]

        return (
            image,
            label,
            str(image_path)
        )


# ============================================================
# 7. LOAD TRAINED MODEL
# ============================================================

def load_evaluation_model(
    dataset_name,
    model_name
):

    checkpoint_path = locate_checkpoint(
        dataset_name,
        model_name
    )

    try:

        checkpoint = torch.load(
            checkpoint_path,
            map_location=DEVICE,
            weights_only=False
        )

    except TypeError:

        checkpoint = torch.load(
            checkpoint_path,
            map_location=DEVICE
        )

    if "model_state_dict" not in checkpoint:

        raise KeyError(
            f"model_state_dict missing in {checkpoint_path}"
        )

    class_names = checkpoint.get(
        "class_names"
    )

    if not class_names:

        raise KeyError(
            f"class_names missing in {checkpoint_path}"
        )

    num_classes = checkpoint.get(
        "num_classes",
        len(class_names)
    )

    if num_classes != len(class_names):

        raise ValueError(
            f"Class count mismatch in {checkpoint_path}"
        )

    # Match the input resolution used by the model.
    image_size = checkpoint.get(
        "image_size",
        ENSEMBLE_IMAGE_SIZE
        if model_name == "Four_Model_Ensemble_LIME"
        else IMAGE_SIZE_DEFAULT
    )

    model = build_model(
        model_name,
        num_classes=num_classes,
        pretrained=False
    )

    model.load_state_dict(
        checkpoint["model_state_dict"]
    )

    model = model.to(DEVICE)

    model.eval()

    parameter_count = sum(
        parameter.numel()
        for parameter in model.parameters()
    )

    trainable_parameters = sum(
        parameter.numel()
        for parameter in model.parameters()
        if parameter.requires_grad
    )

    checkpoint_size_mb = (
        checkpoint_path.stat().st_size
        / (1024 ** 2)
    )

    print("\nLoaded:", MODEL_LABELS[model_name])
    print("Dataset:", dataset_name)
    print("Checkpoint:", checkpoint_path.name)
    print("Classes:", num_classes)
    print("Image size:", image_size)
    print("Parameters:", f"{parameter_count:,}")
    print("Checkpoint size:", f"{checkpoint_size_mb:.2f} MB")

    return (
        model,
        checkpoint,
        class_names,
        image_size,
        parameter_count,
        trainable_parameters,
        checkpoint_size_mb
    )


# ============================================================
# 8. MODEL PREDICTION
# ============================================================

def extract_model_output(outputs):

    if isinstance(outputs, dict):

        for key in [
            "logits",
            "out",
            "output"
        ]:

            if key in outputs:
                outputs = outputs[key]
                break

    if isinstance(outputs, (tuple, list)):

        outputs = outputs[0]

    return outputs


def evaluate_model_predictions(
    model,
    loader
):

    all_true = []

    all_predictions = []

    all_probabilities = []

    all_paths = []

    all_confidences = []

    # Warm-up to reduce initial execution overhead.
    warmup_completed = False

    total_images = 0

    inference_start = time.perf_counter()

    with torch.inference_mode():

        for images, labels, paths in loader:

            images = images.to(DEVICE)

            labels = labels.to(DEVICE)

            if (
                DEVICE.type == "cuda"
                and not warmup_completed
            ):

                warmup_output = model(images)

                if isinstance(warmup_output, (tuple, list)):
                    warmup_output = warmup_output[0]

                torch.cuda.synchronize()

                warmup_completed = True

            outputs = model(images)

            outputs = extract_model_output(
                outputs
            )

            probabilities = torch.softmax(
                outputs,
                dim=1
            )

            predictions = torch.argmax(
                probabilities,
                dim=1
            )

            confidence = probabilities.max(
                dim=1
            ).values

            all_true.extend(
                labels.cpu().numpy()
            )

            all_predictions.extend(
                predictions.cpu().numpy()
            )

            all_probabilities.append(
                probabilities.cpu().numpy()
            )

            all_confidences.extend(
                confidence.cpu().numpy()
            )

            all_paths.extend(paths)

            total_images += len(labels)

        if DEVICE.type == "cuda":
            torch.cuda.synchronize()

    total_inference_time = (
        time.perf_counter() - inference_start
    )

    probabilities = np.concatenate(
        all_probabilities,
        axis=0
    )

    inference_latency = (
        total_inference_time / total_images
    )

    throughput = (
        total_images / total_inference_time
    )

    return {

        "y_true": np.asarray(all_true),

        "y_pred": np.asarray(all_predictions),

        "probabilities": probabilities,

        "paths": all_paths,

        "confidences": np.asarray(
            all_confidences
        ),

        "total_inference_time": (
            total_inference_time
        ),

        "inference_latency": inference_latency,

        "throughput": throughput,

        "total_images": total_images

    }


# ============================================================
# 9. CALCULATE SPECIFICITY
# ============================================================

def calculate_specificity(
    y_true,
    y_pred,
    num_classes
):

    cm = confusion_matrix(
        y_true,
        y_pred,
        labels=np.arange(num_classes)
    )

    specificity_values = []

    for i in range(num_classes):

        true_negative = (
            cm.sum()
            - cm[i, :].sum()
            - cm[:, i].sum()
            + cm[i, i]
        )

        false_positive = (
            cm[:, i].sum() - cm[i, i]
        )

        denominator = (
            true_negative + false_positive
        )

        specificity = (
            true_negative / denominator
            if denominator > 0
            else np.nan
        )

        specificity_values.append(
            specificity
        )

    return float(
        np.nanmean(specificity_values)
    ), specificity_values


# ============================================================
# 10. CALCULATE ROC-AUC AND AVERAGE PRECISION
# ============================================================

def calculate_auc_metrics(
    y_true,
    probabilities,
    num_classes
):

    y_binary = label_binarize(
        y_true,
        classes=np.arange(num_classes)
    )

    # Multiclass macro and weighted AUC.
    try:

        macro_auc = roc_auc_score(
            y_binary,
            probabilities,
            average="macro"
        )

    except ValueError:

        macro_auc = np.nan

    try:

        weighted_auc = roc_auc_score(
            y_binary,
            probabilities,
            average="weighted"
        )

    except ValueError:

        weighted_auc = np.nan

    try:

        micro_auc = roc_auc_score(
            y_binary.ravel(),
            probabilities.ravel()
        )

    except ValueError:

        micro_auc = np.nan

    try:

        micro_ap = average_precision_score(
            y_binary,
            probabilities,
            average="micro"
        )

    except ValueError:

        micro_ap = np.nan

    return (
        macro_auc,
        weighted_auc,
        micro_auc,
        micro_ap,
        y_binary
    )


# ============================================================
# 11. COMPREHENSIVE CLASSIFICATION METRICS
# ============================================================

def calculate_metrics(
    predictions,
    class_names,
    model_name,
    dataset_name,
    model_information
):

    y_true = predictions["y_true"]

    y_pred = predictions["y_pred"]

    probabilities = predictions["probabilities"]

    num_classes = len(class_names)

    specificity, class_specificity = (
        calculate_specificity(
            y_true,
            y_pred,
            num_classes
        )
    )

    (
        macro_auc,
        weighted_auc,
        micro_auc,
        micro_ap,
        y_binary
    ) = calculate_auc_metrics(
        y_true,
        probabilities,
        num_classes
    )

    macro_precision = precision_score(
        y_true,
        y_pred,
        average="macro",
        zero_division=0
    )

    weighted_precision = precision_score(
        y_true,
        y_pred,
        average="weighted",
        zero_division=0
    )

    macro_recall = recall_score(
        y_true,
        y_pred,
        average="macro",
        zero_division=0
    )

    weighted_recall = recall_score(
        y_true,
        y_pred,
        average="weighted",
        zero_division=0
    )

    macro_f1 = f1_score(
        y_true,
        y_pred,
        average="macro",
        zero_division=0
    )

    weighted_f1 = f1_score(
        y_true,
        y_pred,
        average="weighted",
        zero_division=0
    )

    accuracy = accuracy_score(
        y_true,
        y_pred
    )

    mcc = matthews_corrcoef(
        y_true,
        y_pred
    )

    kappa = cohen_kappa_score(
        y_true,
        y_pred
    )

    balanced_accuracy = balanced_accuracy_score(
        y_true,
        y_pred
    )

    metrics = {

        "dataset": dataset_name,

        "model": model_name,

        "model_label": MODEL_LABELS[model_name],

        "accuracy": accuracy,

        "balanced_accuracy": balanced_accuracy,

        "macro_precision": macro_precision,

        "weighted_precision": weighted_precision,

        "macro_recall": macro_recall,

        "weighted_recall": weighted_recall,

        "macro_f1": macro_f1,

        "weighted_f1": weighted_f1,

        "macro_specificity": specificity,

        "macro_auc": macro_auc,

        "weighted_auc": weighted_auc,

        "micro_auc": micro_auc,

        "micro_average_precision": micro_ap,

        "mcc": mcc,

        "cohen_kappa": kappa,

        "mean_prediction_confidence": float(
            np.mean(predictions["confidences"])
        ),

        "total_inference_time_seconds": (
            predictions["total_inference_time"]
        ),

        "inference_latency_ms": (
            predictions["inference_latency"] * 1000
        ),

        "throughput_images_per_second": (
            predictions["throughput"]
        ),

        "num_test_images": (
            predictions["total_images"]
        ),

        "parameters": model_information[
            "parameters"
        ],

        "trainable_parameters": model_information[
            "trainable_parameters"
        ],

        "model_size_mb": model_information[
            "model_size_mb"
        ]

    }

    # Per-class metrics.
    report = classification_report(
        y_true,
        y_pred,
        labels=np.arange(num_classes),
        target_names=class_names,
        output_dict=True,
        zero_division=0
    )

    per_class_records = []

    for i, class_name in enumerate(class_names):

        per_class_records.append({

            "dataset": dataset_name,

            "model": model_name,

            "class_name": class_name,

            "precision": report[class_name]["precision"],

            "recall": report[class_name]["recall"],

            "f1_score": report[class_name]["f1-score"],

            "support": report[class_name]["support"],

            "specificity": class_specificity[i],

            "auc": (
                roc_auc_score(
                    y_binary[:, i],
                    probabilities[:, i]
                )
                if len(np.unique(y_binary[:, i])) == 2
                else np.nan
            )

        })

    return (
        metrics,
        pd.DataFrame(per_class_records),
        y_binary
    )


