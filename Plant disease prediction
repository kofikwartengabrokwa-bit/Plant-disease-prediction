# ------------------------------------------------------------
# 15. OVERALL STABILITY RANKING
# ------------------------------------------------------------
# Average rank across Spearman correlation,
# cosine similarity and top-k overlap.
#
# Higher is better for all three metrics.

ranking_source = stability_summary.copy()

ranking_source["spearman_rank"] = (
    ranking_source["spearman_correlation"]
    .rank(
        ascending=False,
        method="average"
    )
)

ranking_source["cosine_rank"] = (
    ranking_source["cosine_similarity"]
    .rank(
        ascending=False,
        method="average"
    )
)

ranking_source["top_k_overlap_rank"] = (
    ranking_source["top_k_overlap"]
    .rank(
        ascending=False,
        method="average"
    )
)

ranking_source["mean_stability_rank"] = (
    ranking_source[
        [
            "spearman_rank",
            "cosine_rank",
            "top_k_overlap_rank"
        ]
    ].mean(axis=1)
)

ranking_source = ranking_source.sort_values(
    [
        "dataset",
        "transformation",
        "mean_stability_rank"
    ]
)

ranking_source.to_csv(
    TABLE_DIR / "explanation_stability_ranking.csv",
