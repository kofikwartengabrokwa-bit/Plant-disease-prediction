def evaluate_cross_dataset(
    model,
    target_df,
    target_to_source,
    source_classes,
    image_size,
    model_name,
    source_dataset,
    target_dataset
):
    transform = make_transform(image_size)

    model.eval()

    y_true = []
    y_pred = []
    y_prob = []
    records = []

    skipped_images = 0

    # Use the checkpoint's class order for model outputs.
    source_class_count = len(source_classes)

    for start in range(0, len(target_df), BATCH_SIZE):

        batch_df = target_df.iloc[
            start:start + BATCH_SIZE
        ]

        batch_images = []
        batch_labels = []
        batch_paths = []
        batch_names = []

        for _, row in batch_df.iterrows():

            target_class = row["class_name"]

            if target_class not in target_to_source:
                continue

            image_path = resolve_image_path(
                row["image_path"],
                target_dataset
            )

            try:
                image = Image.open(image_path).convert("RGB")
                image_tensor = transform(image)

            except Exception as error:
                skipped_images += 1
                warnings.warn(
                    f"Skipping image {image_path}: {error}"
                )
                continue

            batch_images.append(image_tensor)

            batch_labels.append(
                target_to_source[target_class]
            )

            batch_paths.append(str(image_path))
            batch_names.append(target_class)

        if not batch_images:
            continue

        inputs = torch.stack(batch_images).to(DEVICE)

        with torch.no_grad():
            outputs = model(inputs)

            if outputs.ndim != 2:
                raise ValueError(
                    f"{model_name} returned unexpected output shape "
                    f"{tuple(outputs.shape)}"
                )

            if outputs.shape[1] != source_class_count:
                raise ValueError(
                    f"{model_name}: model output dimension "
                    f"({outputs.shape[1]}) does not match checkpoint "
                    f"class count ({source_class_count})."
                )

            probabilities = torch.softmax(
                outputs,
                dim=1
            )

            predicted_indices = probabilities.argmax(dim=1)

        probabilities_np = probabilities.cpu().numpy()
        predicted_np = predicted_indices.cpu().numpy()

        y_true.extend(batch_labels)
        y_pred.extend(predicted_np.tolist())
        y_prob.extend(probabilities_np.tolist())

        for i in range(len(batch_labels)):

            predicted_index = int(predicted_np[i])

            records.append({
                "source_dataset": source_dataset,
                "target_dataset": target_dataset,
                "model": model_name,
                "image_path": batch_paths[i],
                "true_target_class": batch_names[i],
                "true_source_class": source_classes[
                    batch_labels[i]
                ],
                "predicted_class": source_classes[
                    predicted_index
                ],
                "correct": (
                    predicted_index == batch_labels[i]
                ),
                "confidence": float(
                    probabilities_np[i].max()
                )
            })

    if len(y_true) == 0:
        raise ValueError(
            "No valid target images were evaluated."
        )

    y_true = np.asarray(y_true)
    y_pred = np.asarray(y_pred)
    y_prob = np.asarray(y_prob)

    labels = list(range(len(source_classes)))

    accuracy = accuracy_score(y_true, y_pred)

    balanced_accuracy = balanced_accuracy_score(
        y_true,
        y_pred
    )

    precision, recall, f1, support = (
        precision_recall_fscore_support(
            y_true,
            y_pred,
            labels=labels,
            average=None,
            zero_division=0
        )
    )

    macro_precision = precision_recall_fscore_support(
        y_true,
        y_pred,
        labels=labels,
        average="macro",
        zero_division=0
    )[0]

    macro_recall = precision_recall_fscore_support(
        y_true,
        y_pred,
        labels=labels,
        average="macro",
        zero_division=0
    )[1]

    macro_f1 = precision_recall_fscore_support(
        y_true,
        y_pred,
        labels=labels,
        average="macro",
        zero_division=0
    )[2]

    weighted_f1 = precision_recall_fscore_support(
        y_true,
        y_pred,
        labels=labels,
        average="weighted",
        zero_division=0
    )[2]

    mean_confidence = float(
        np.max(y_prob, axis=1).mean()
    )

    metrics = {
        "source_dataset": source_dataset,
        "target_dataset": target_dataset,
        "model": model_name,
        "evaluated_images": len(y_true),
        "skipped_images": skipped_images,
        "num_shared_classes": len(source_classes),
        "accuracy": accuracy,
        "balanced_accuracy": balanced_accuracy,
        "macro_precision": macro_precision,
        "macro_recall": macro_recall,
        "macro_f1": macro_f1,
        "weighted_f1": weighted_f1,
        "mean_confidence": mean_confidence
    }

    per_class = []

    for class_index, class_name in enumerate(source_classes):
        per_class.append({
            "source_dataset": source_dataset,
            "target_dataset": target_dataset,
            "model": model_name,
            "class_name": class_name,
            "precision": precision[class_index],
            "recall": recall[class_index],
            "f1_score": f1[class_index],
            "support": int(support[class_index])
        })

    cm = confusion_matrix(
        y_true,
        y_pred,
        labels=labels
    )

    return (
        metrics,
        per_class,
        records,
        cm
    )


