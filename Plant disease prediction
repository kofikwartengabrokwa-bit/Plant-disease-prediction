def verify_paired_predictions(
    proposed_df,
    baseline_df,
    dataset_name,
    baseline_name
):

    proposed_paths = set(
        proposed_df["image_path"]
    )

    baseline_paths = set(
        baseline_df["image_path"]
    )

    if proposed_paths != baseline_paths:

        raise ValueError(
            f"Test images differ between CNN-MHA and "
            f"{baseline_name} for {dataset_name}. "
            "Statistical comparison requires identical "
            "test images."
        )

    merged = proposed_df.merge(
        baseline_df,
        on="image_path",
        suffixes=("_proposed", "_baseline"),
        validate="one_to_one"
    )

    if not np.array_equal(
        merged["actual_class_proposed"].values,
        merged["actual_class_baseline"].values
    ):

        raise ValueError(
            "Ground-truth labels do not match."
        )

    return merged


