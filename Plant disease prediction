def load_checkpoint(checkpoint_path):

    if not checkpoint_path.exists():
        raise FileNotFoundError(
            f"Checkpoint not found: {checkpoint_path}"
        )

    try:
        checkpoint = torch.load(
            checkpoint_path,
            map_location=DEVICE,
            weights_only=False
        )
    except TypeError:
        checkpoint = torch.load(
            checkpoint_path,
            map_location=DEVICE
        )

    if not isinstance(checkpoint, dict):
        raise ValueError(
            "Checkpoint must be a dictionary."
        )

    state_dict = checkpoint.get(
        "model_state_dict",
        checkpoint.get("state_dict")
    )

    if state_dict is None:
        raise KeyError(
            "Checkpoint does not contain model_state_dict "
            "or state_dict."
        )

    if "class_names" not in checkpoint:
        raise KeyError(
            "Checkpoint does not contain class_names."
        )

    return checkpoint, state_dict


def get_test_image(dataset_name):

    manifest_path = (
        MANIFEST_DIR
        / dataset_name
        / "split_manifest.csv"
    )

    if not manifest_path.exists():
        raise FileNotFoundError(
            f"Manifest not found: {manifest_path}"
        )

    df = pd.read_csv(manifest_path)

    required = {"image_path", "split"}

    if not required.issubset(df.columns):
        raise ValueError(
            f"Manifest requires columns: {required}"
        )

    test_df = df[
        df["split"].astype(str).str.lower().eq("test")
    ].copy()

    if test_df.empty:
        raise ValueError(
            f"No test images found for {dataset_name}."
        )

    row = test_df.iloc[0]

    image_path = Path(str(row["image_path"]))

    if not image_path.is_absolute():
        candidates = [
            PROJECT_DIR / image_path,
            DATA_DIR / dataset_name / image_path
        ]

        image_path = next(
            (
                candidate
                for candidate in candidates
                if candidate.exists()
            ),
            candidates[0]
        )

    if not image_path.exists():
        raise FileNotFoundError(
            f"Test image not found: {image_path}"
        )

    return image_path


def make_transform(image_size):

    return transforms.Compose([
        transforms.Resize(
            (image_size, image_size)
        ),
        transforms.ToTensor(),
        transforms.Normalize(
            mean=[0.485, 0.456, 0.406],
            std=[0.229, 0.224, 0.225]
        )
    ])


def count_parameters(model):

    total_parameters = sum(
        parameter.numel()
        for parameter in model.parameters()
    )

    trainable_parameters = sum(
        parameter.numel()
        for parameter in model.parameters()
        if parameter.requires_grad
    )

    return total_parameters, trainable_parameters


def calculate_checkpoint_size(checkpoint_path):

    return (
        checkpoint_path.stat().st_size
        / (1024 ** 2)
    )


def calculate_model_size(model):

    total_bytes = 0

    for parameter in model.parameters():
        total_bytes += (
            parameter.numel()
            * parameter.element_size()
        )

    for buffer in model.buffers():
        total_bytes += (
            buffer.numel()
            * buffer.element_size()
        )

    return total_bytes / (1024 ** 2)


# ------------------------------------------------------------
# 5. OPTIONAL FLOPs PROFILER
# ------------------------------------------------------------
# Uses fvcore when installed.
# If unavailable, FLOPs are recorded as NaN.
# Do not replace missing FLOPs with invented estimates.

def calculate_flops(model, input_tensor):

    try:
        from fvcore.nn import FlopCountAnalysis

        model.eval()

        with torch.no_grad():
            analysis = FlopCountAnalysis(
                model,
                input_tensor
            )

            flops = analysis.total()

        return float(flops), "fvcore"

    except ImportError:
        return np.nan, "fvcore_not_installed"

    except Exception as error:
        warnings.warn(
            f"FLOPs calculation failed: {error}"
        )

        return np.nan, "flops_calculation_failed"


# ------------------------------------------------------------
# 6. INFERENCE TIMING
# ------------------------------------------------------------

def benchmark_inference(model, input_tensor):

    model.eval()

    # Warm-up
    with torch.no_grad():

        for _ in range(WARMUP_ITERATIONS):

            _ = model(input_tensor)

    if DEVICE.type == "cuda":
        torch.cuda.synchronize()

        torch.cuda.reset_peak_memory_stats(
            DEVICE
        )

    elapsed_times = []

    with torch.no_grad():

        for _ in range(TIMING_ITERATIONS):

            if DEVICE.type == "cuda":
                torch.cuda.synchronize()

            start_time = time.perf_counter()

            _ = model(input_tensor)

            if DEVICE.type == "cuda":
                torch.cuda.synchronize()

            end_time = time.perf_counter()

            elapsed_times.append(
                end_time - start_time
            )

    elapsed_times = np.asarray(elapsed_times)

    mean_latency = float(
        elapsed_times.mean() * 1000
    )

    median_latency = float(
        np.median(elapsed_times) * 1000
    )

    std_latency = float(
        elapsed_times.std() * 1000
    )

    throughput = (
        1000.0 / mean_latency
        if mean_latency > 0
        else np.nan
    )

    if DEVICE.type == "cuda":

        peak_memory = (
            torch.cuda.max_memory_allocated(DEVICE)
            / (1024 ** 2)
        )

    else:
        peak_memory = np.nan

    return {
        "mean_latency_ms": mean_latency,
        "median_latency_ms": median_latency,
        "std_latency_ms": std_latency,
        "throughput_images_per_second": throughput,
        "peak_gpu_memory_mb": peak_memory
    }


