def plot_roc_curve(
    y_binary,
    probabilities,
    dataset_name,
    model_name
):

    fig, ax = plt.subplots(
        figsize=(8, 7)
    )

    valid_classes = 0

    for i in range(y_binary.shape[1]):

        if len(np.unique(y_binary[:, i])) < 2:
            continue

        fpr, tpr, _ = roc_curve(
            y_binary[:, i],
            probabilities[:, i]
        )

        auc_value = roc_auc_score(
            y_binary[:, i],
            probabilities[:, i]
        )

        ax.plot(
            fpr,
            tpr,
            linewidth=1.5,
            alpha=0.6,
            label=f"Class {i + 1}: AUC={auc_value:.3f}"
        )

        valid_classes += 1

    if valid_classes == 0:

        plt.close(fig)
        return

    ax.plot(
        [0, 1],
        [0, 1],
        linestyle="--",
        linewidth=1.5,
        label="Random Classifier"
    )

    ax.set_xlabel("False Positive Rate")

    ax.set_ylabel("True Positive Rate")

    ax.set_title(
        f"Multiclass ROC - "
        f"{MODEL_LABELS[model_name]} "
        f"({dataset_name.title()})"
    )

    ax.legend(
        loc="lower right",
        fontsize=7
    )

    ax.grid(
        True,
        linestyle="--",
        alpha=0.4
    )

    plt.tight_layout()

    plt.savefig(
        FIGURE_DIR
        / f"{dataset_name}_{model_name}_ROC.png",
        dpi=600,
        bbox_inches="tight"
    )

    plt.close(fig)


