# ------------------------------------------------------------
# 8. MODEL PREDICTION FUNCTION FOR LIME
# ------------------------------------------------------------

def create_lime_predict_function(model):

    def predict_images(images):

        batch_tensors = []

        for image in images:

            # LIME supplies RGB arrays in the [0, 255] range.
            pil_image = Image.fromarray(
                np.uint8(np.clip(image, 0, 255))
            ).convert("RGB")

            pil_image = pil_image.resize(
                (IMAGE_SIZE, IMAGE_SIZE)
            )

            tensor = transforms.ToTensor()(pil_image)

            tensor = normalization(tensor)

            batch_tensors.append(tensor)

        all_probabilities = []

        with torch.no_grad():

            for start in range(
                0,
                len(batch_tensors),
                BATCH_SIZE
            ):

                batch = torch.stack(
                    batch_tensors[
                        start:start + BATCH_SIZE
                    ]
                ).to(DEVICE)

                logits = model(batch)

                probabilities = torch.softmax(
                    logits,
                    dim=1
                )

                all_probabilities.append(
                    probabilities.cpu().numpy()
                )

        return np.concatenate(
            all_probabilities,
            axis=0
        )

    return predict_images


