# ------------------------------------------------------------
# 13. AGGREGATE EXPLANATION STABILITY
# ------------------------------------------------------------

stability_metrics = [
    "pearson_correlation",
    "spearman_correlation",
    "cosine_similarity",
    "top_k_overlap"
]

stability_summary = (
    stability_df
    .groupby(
        [
            "dataset",
            "model",
            "transformation"
        ],
        as_index=False
    )[stability_metrics]
    .mean()
)

