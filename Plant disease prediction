                            "white"
                            if cm[row_idx, col_idx] > threshold
                            else "black"
                        )
                    )

            fig.colorbar(im, ax=ax)
            fig.tight_layout()

            fig.savefig(
                CONFUSION_DIR
                / f"{source_dataset}_to_{target_dataset}_"
                  f"{model_key}_confusion_matrix.png",
                dpi=600,
                bbox_inches="tight"
            )

            plt.close(fig)

            print(
