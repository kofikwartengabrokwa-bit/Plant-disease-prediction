def calculate_uncertainty_metrics(probabilities):

    probabilities = np.asarray(
        probabilities,
        dtype=np.float64
    )

    probabilities = np.clip(
        probabilities,
        EPSILON,
        1.0
    )

    probabilities = probabilities / (
        probabilities.sum(axis=1, keepdims=True)
    )

    num_classes = probabilities.shape[1]

    confidence = np.max(
        probabilities,
        axis=1
    )

    entropy = -np.sum(
        probabilities * np.log(probabilities),
        axis=1
    )

    if num_classes > 1:

        normalized_entropy = entropy / np.log(
            num_classes
        )

    else:

        normalized_entropy = np.zeros_like(entropy)

    sorted_probabilities = np.sort(
        probabilities,
        axis=1
    )

    if num_classes >= 2:

        confidence_margin = (
            sorted_probabilities[:, -1] -
            sorted_probabilities[:, -2]
        )

    else:

        confidence_margin = confidence.copy()

    return {
        "confidence": confidence,
        "entropy": entropy,
        "normalized_entropy": normalized_entropy,
        "confidence_margin": confidence_margin
    }

